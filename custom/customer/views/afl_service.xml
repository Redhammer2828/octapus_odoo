<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aaa_service_tree" model="ir.ui.view">
        <field name="name">aaa.service.tree</field>
        <field name="model">aaa.service</field>
        <field name="arch" type="xml">
            <tree string="AFL Service Dashboard" decoration-success="state == 'initiate' and time_difference &gt; 5" decoration-info="state == 'start' and time_difference &gt; 30 and time_difference &lt;= 45" decoration-warning="state == 'start' and time_difference &gt; 45 and time_difference &lt;= 120" decoration-danger="state == 'start' and time_difference &gt;= 120" class="aaa_service_tree" create="False" default_order="id desc">
                <field name="job_ref" />
                <field name="name" string ="ERP Number" />
                <field name="service_time" string="Entry date" />
                <field name="member_id" />
                <field name="member_contact_no" />
                <field name="vehicle_type" />
                <field name="vehicle_model" />
                <field name="vehicle_plate" />
                <field name="from_location" />
                <field name="to_location" />
                <field name="product_id" />
                <field name="state" />
                <field name="ser_id" />
                <field name="initate_date" />
                <field name="driver_reach_date" />
                <field name="current_time" invisible='1' />
                <field name="time_difference" invisible='1' />
                <field name="create_date" invisible='1' />
            </tree>
        </field>
    </record>
    <record id="view_aaa_service_search" model="ir.ui.view">
        <field name="name">aaa.service.search</field>
        <field name="model">aaa.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="job_ref" string ="Job Ref No." />
                <field name="name" string ="ERP Number" />
                <field name="service_time" string="Entry date" />
                <field name="member_id" string = "Name"/>
                <field name="member_contact_no" string="Contact"/>
                <field name="vehicle_type" string="Vehicle Type"/>
                <field name="vehicle_model" string="Vehicle Model"/>
                <field name="vehicle_plate" string="Vehicle Plate"/>
                <field name="from_location" string="From Location"/>
                <field name="to_location" string="To Location"/>
                <field name="product_id" string="Service"/>
                <field name="state" string="State"/>
                <field name="ser_id" />
                <field name="initate_date" string="Initiate Date"/>
                <field name="driver_reach_date" string="Driver Reach Date"/>
                <!-- <field name="current_time" invisible='1' /> -->
                <!-- <field name="time_difference" invisible='1' /> -->
            </search>
        </field>
    </record>

    <record id="afl_service_action" model="ir.actions.act_window">
        <field name="name">AFL Service Dashboard</field>
        <field name="res_model">aaa.service</field>
        <field name="view_mode">tree</field>            <!-- Restrict to tree view only -->
            <field name="view_ids" eval="[ 
              (5, 0, 0), 
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.view_aaa_service_tree')}) 
            ]"/>
            <field name="context">{'form_view_ref': False, 'create': False, 'edit': False}</field>                 <!-- Disable form view -->
            <field name="domain">[('customer_id', '=', 'AL FUTTAIM LOGISTICS AUTOMOTIVE COMPANY L.L.C')]</field>
            <field name="help">This dashboard shows the current status of all services.</field>
            </record>



        </odoo>