<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="member_vehicle_type_view_form" model="ir.ui.view">
            <field name="name">member.vehicle.type.view.form</field>
            <field name="model">member.vehicle.type</field>
            <field name="arch" type="xml">
                <form string="Vehicle Type">
                    <sheet>
                        <group>
                            <field name="name" placeholder='Vehicle Name' required='1' />
                        </group>
                            <field name="vehicle_model_ids"  widget="one2many_list" >
                                <tree editable="bottom" string="Models">
                                    <field name="name"/>
                                </tree>
                            </field>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="member_vehicle_type_view_tree" model="ir.ui.view">
            <field name="name">member.vehicle.type.view.tree</field>
            <field name="model">member.vehicle.type</field>
            <field name="arch" type="xml">
                <tree string="Vehicle Type">
                    <field name="name" />
                    <field name="create_date" />
                </tree>
            </field>
        </record>
        
        <record id="member_vehicle_type_action" model="ir.actions.act_window">
            <field name="name">Member Vehicle Type</field>
            <field name="res_model">member.vehicle.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new card type.
                </p>
            </field>
        </record>
        
        <!-- <menuitem
            id="menu_member_vehicle_type"
            name="Vehicle Type"
            parent="menu_configuration"
            action="member_vehicle_type_action"
            sequence="40" /> -->

        <menuitem id="menu_member_vehicle_type" name="Vehicle Type" parent="menu_configuration" action="member_vehicle_type_action" sequence="40"/>

    </data>
</odoo>