<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="credit_service_validation_view_tree" model="ir.ui.view">
        <field name="name">credit.service.validation.view.tree</field>
        <field name="model">credit.service.validation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="partner_id" />
                <field name="member_type" />
                <field name="category_id" />
                <field name="from_date" />
                <field name="to_date" />
                <field name="state" widget="badge" />
            </tree>
        </field>
    </record>

    <record id="credit_service_validation_view_form" model="ir.ui.view">
        <field name="name">credit.service.validation.view.form</field>
        <field name="model">credit.service.validation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="get_services" type="object" string="Get Services" class="btn-primary" invisible="state == 'confirm'" />
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state == 'confirm'" />
                    <button name="action_draft" type="object" string="Reset to Draft" invisible="state == 'draft'" />
                    <field name="state" widget="statusbar" options="{'clickale':0}" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" domain="[('is_company', '=', True)]" options="{'no_create': True, 'no_quick_create': True}" required="1" />
                            <field name="member_type" readonly="1" />
                            <field name="category_id" required="1" />
                        </group>
                        <group>
                            <field name="from_date" required="1" />
                            <field name="to_date" required="1" />
                        </group>
                    </group>
                    <notebook>
                        <page name="service_lines" string="Service Statements">
                            <field name="service_line_ids">
                                <tree editable="bottom">
                                    <field name="credit_service_id" column_invisible="1" />
                                    <field name="service_date" />
                                    <field name="service_number" />
                                    <field name="trip_sheet_number" />
                                    <field name="vehicle_model" />
                                    <field name="vehicle_plate" />
                                    <field name="service_product" />
                                    <field name="from_location" />
                                    <field name="to_location" />
                                    <field name="price" />
                                    <field name="add_to_report" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="credit_service_validation_action" model="ir.actions.act_window">
        <field name="name">Credit Service Validation</field>
        <field name="res_model">credit.service.validation</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_credit_service_validation"
        name="Credit Service Validation"
        action="credit_service_validation_action"
        parent="account.menu_finance_receivables"
        sequence="1"/>

    <menuitem
        id="account_all_services_menu"
        name="All Services"
        action="call_center_all_service_action"
        parent="account.menu_finance"
        sequence="2"/>


</odoo>
