<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="product_packages_view_form" model="ir.ui.view">
            <field name="name">product.packages.view.form</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <form string="">
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus)
                        {
                        border-bottom: 1px solid #71639e2b;
                        }
                        .custom_field{
                        background-color: #d2d2ff8f;
                        border-radius: 5px;
                        }
                        .required_field{
                        background-color: #b9a4ff29;
                        }
                        .my_custom_tree [data-name="categ_id"] {
                        width: 100px;
                        }

                        .my_custom_tree [data-name="hours"] {
                        width: 200px;
                        }
                    </style>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active" widget_id="widget_1" />
                        <field name="id" invisible="True" field_id="id_0" />
                        <field name="image_1920" widget="image" class="oe_avatar"
                            options="{'preview_image': 'image_128'}" field_id="image_1920_0" />
                        <div class="oe_title">
                            <label for="name" string="Product Name" />
                            <h1>
                                <div class="d-flex">
                                    <field name="priority" widget="priority" class="me-3"
                                        field_id="priority_0" />
                                    <field class="text-break required_field" name="name"
                                        options="{'line_breaks': False}" widget="text"
                                        placeholder="Product Name" field_id="name_0" />
                                </div>
                            </h1>
                        </div>
                        <div name="options">
                            <span class="d-inline-block">
                                <field name="sale_ok" field_id="sale_ok_0" />
                                <label for="sale_ok" />
                            </span>
                            <span class="d-inline-block">
                                <field name="purchase_ok" field_id="purchase_ok_0" />
                                <label for="purchase_ok" />
                            </span>
                            <span class="d-inline-block">
                                <field name="bundle_product" on_change="1" />
                                <label for="bundle_product" string="Bundle product?" />
                            </span>
                            <!-- <span class="d-inline-block">
                                <field name="is_packages" on_change="1" invisible="1"/>
                                <label for="is_packages" string="is Packages" />
                            </span>
                            <span class="d-inline-block">
                                <field name="is_services" on_change="1" invisible="1"/>
                                <label for="is_services" string="is Services" />
                            </span> -->
                        </div>
                        <notebook>
                            <page string="General Information" name="general_information">
                                <group>
                                    <group name="group_general">
                                        <field name="active" invisible="1" field_id="active_0" />
                                        <field name="detailed_type" on_change="1"
                                            field_id="detailed_type_0" class="required_field" />
                                        <!-- <field name="service_type" class="required_field" /> -->
                                        <field name="categ_id" string="Product Category"
                                            on_change="1" can_create="True" can_write="True"
                                            field_id="categ_id_0" class="required_field" />
                                    </group>
                                    <group name="Unit of Measure">
                                        <field name="uom_id" class="required_field" />
                                        <field name="uom_po_id" class="required_field" />
                                    </group>
                                </group>
                                <group string="Internal Notes">
                                    <field colspan="2" name="description" nolabel="1"
                                        placeholder="This note is only for internal purposes."
                                        field_id="description_0" />
                                </group>
                            </page>

                            <!-- SERVICES -->
                            <page string="Services">
                                <field name="service_ids" widget="one2many_list">
                                    <tree editable="bottom">
                                        <field name="product_id" domain="[('service_type', '=', 'none')]" />
                                        <field name="is_intercity"/>
                                        <field name="quantity" />
                                    </tree>
                                </field>
                            </page>

                            <!-- CATEGORY LIMIT -->
                            <page name="category_limit" string="Category Limit">
                                <field name="category_limit_ids" widget="one2many_list">
                                    <tree editable="bottom" class="my_custom_tree">
                                        <field name="categ_id" />
                                        <field name="hours" />
                                        <field name="uom_id" />
                                        <field name="quantity" />
                                    </tree>
                                </field>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_packages_view_tree" model="ir.ui.view">
            <field name="name">product.packages.view.tree</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <tree string="Packages">
                    <field name="id" />
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="standard_price" />
                    <field name="categ_id" />
                    <field name="type" />
                    <field name="uom_id" />
                    <field name="active" invisible="1" />
                    <field name="create_date" />
                </tree>
            </field>
        </record>

        <record id="action_product_packages" model="ir.actions.act_window">
            <field name="name">Product Packages</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'product_packages_view_form': True,
                'default_bundle_product': True ,
                'default_detailed_type': 'service'}</field>
            <field name="domain">[
                ('bundle_product', '=', True)]</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.product_packages_view_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.product_packages_view_form')})
        ]">
            </field>
        </record>

        <menuitem
            id="menu_product_packages"
            name="Packages"
            parent="menu_product"
            action="action_product_packages" sequence="15" />
    </data>

</odoo>