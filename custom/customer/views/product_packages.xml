<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="product_packages_view_form" model="ir.ui.view">
            <field name="name">product.packages.view.form</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <field name="image_1920" widget="image" class="oe_avatar"
                            options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}" />

                        <div class="oe_title">
                            <h4>Product Name:</h4>
                            <field name="name" placeholder="Type.." />
                        </div>
                        <notebook colspan="1">
                            <page name="General Information" string="General Information">
                                <group>
                                    <field name="detailed_type" />
                                    <field name="categ_id" />
                                    <field name="default_code" />
                                    <field name="barcode" />
                                </group>
                                <group>
                                    <field name="list_price" />
                                    <!-- <field name="taxes_id"/> -->
                                    <field name="standard_price" />
                                    <field name="uom_id" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_packages_view_tree" model="ir.ui.view">
            <field name="name">product.packages.view.tree</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <tree string="Packages">
                    <field name="id" />
                    <field name="sequence" widget="handle" />
                    <field name="name" />
                    <field name="standard_price" />
                    <field name="categ_id" />
                    <field name="type" />
                    <field name="uom_id" />
                    <field name="active" invisible="1" />
                    <field name="create_date" />
                </tree>
            </field>
        </record>

        <record id="action_product_packages" model="ir.actions.act_window">
            <field name="name">Product Packages</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.product_packages_view_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.product_packages_view_form')})
        ]">
            </field>
            <field name="help" type="html">
                <p>new</p>
            </field>
        </record>

        <menuitem
            id="menu_product_packages"
            name="Packages"
            parent="menu_product"
            action="action_product_packages" sequence="15" />
    </data>


</odoo>