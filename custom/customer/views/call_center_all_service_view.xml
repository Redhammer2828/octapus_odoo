<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="call_center_all_service_view_tree" model="ir.ui.view">
            <field name="name">call.center.all.service.view.tree</field>
            <field name="model">aaa.service</field>
            <field name="arch" type="xml">
                <tree string="Services" create="false" duplicate="false">
                    <field name="name" />
                    <field name="service_time" string="Service Date" />
                    <field name="customer_id" />
                    <field name="member_id" />
                    <field name="member_contact_no" string="Mobile Number" />
                    <field name="vehicle_type" />
                    <field name="product_id" string="Service" />
                    <field name="selected_from_location" string="Policy From" />
                    <field name="selected_to_location" string=" Policy To" />
                    <field name="from_location" string="From" />
                    <field name="to_location" string="To" />
                    <field name="provider_id" string="Provider" />
                    <field name="created_by" string="Agent" />
                    <field name="state" string="Status" />
                </tree>
            </field>
        </record>
        <!-- Define the search view -->
        <record id="call_center_all_service_view_search" model="ir.ui.view">
            <field name="name">call.center.all.service.view.search</field>
            <field name="model">aaa.service</field>
            <field name="arch" type="xml">
                <search>
                    <!-- Search fields -->
                    <field name="name" />
                    <field name="created_by" />
                    <field name="product_id" string="Service" />
                    <field name="requested_date" />
                    <field name="member_id" />
                    <field name="customer_id" />
                    <field name="membership_num" />
                    <field name="old_membership_number" />
                    <field name="member_contact_no" />
                    <!-- <field name="driving_license" /> -->
                    <field name="vehicle_type" />
                    <field name="vehicle_model" />
                    <field name="vehicle_plate" />
                    <field name="vehicle_chasis_no" />
                    <field name="policy_no" string="Policy Number" />
                    <field name="provider_id" string="Provider" />
                    <field name="driver_name" />
                    <field name="state" string="State" />
                    <field name="credit_proforma_number" string="Trip Sheet Number" />
                    <filter name="today_records" string="Today's Records"
                        domain="[('is_today', '=', True)]" />


                </search>
            </field>
        </record>

        <record id="call_center_all_service_action" model="ir.actions.act_window">
            <field name="name">All Service</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="call_center_all_service_view_search" />
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[
                  (5, 0, 0),
                  (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
                  (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
                ]">
            </field>
        </record>


        <record id="call_center_to_dispatch_service_action" model="ir.actions.act_window">
            <field name="name">To Dispatch</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=', 'dispatch')]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
            </field>
        </record>
        <record id="call_center_in_progress_service_action" model="ir.actions.act_window">
            <field name="name">In Progress</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', 'in', ['inprogress', 'start', 'reach'])]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
            </field>
        </record>
        <record id="call_center_completed_service_action" model="ir.actions.act_window">
            <field name="name">Completed</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=', 'done')]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
            </field>
        </record>
        <record id="call_center_cancelled_service_action" model="ir.actions.act_window">
            <field name="name">Cancelled</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=', 'cancel')]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
            </field>
        </record>
        <record id="call_center_requested_service_action" model="ir.actions.act_window">
            <field name="name">Requested</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=','requested')]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
            </field>
        </record>
        <record id="call_center_initiate_service_action" model="ir.actions.act_window">
            <field name="name">Scheduled</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=', 'initiate'), ('schedule_date_time', '!=', False),
                ('requested_date', '!=', False)]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[ 
                    (5, 0, 0),
                    (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
                ]">
            </field>
        </record>
        <menuitem
            id="menu_all_service_root"
            name="All Services"
            parent="menu_call_center_root"
            sequence="3"
        />
        <menuitem
            id="menu_all_service"
            name="All"
            parent="menu_all_service_root"
            action="call_center_all_service_action"
            sequence="1"
        />
        <menuitem
            id="menu_to_dispatch_service"
            name="To Dispatch"
            parent="menu_all_service_root"
            action="call_center_to_dispatch_service_action"
            sequence="2"
        />
        <menuitem
            id="menu_in_progress_service"
            name="In Progress"
            parent="menu_all_service_root"
            action="call_center_in_progress_service_action"
            sequence="3"
        />
        <menuitem
            id="menu_completed_service"
            name="Completed"
            parent="menu_all_service_root"
            action="call_center_completed_service_action"
            sequence="5"
        />
        <menuitem
            id="menu_cancelled_service"
            name="Cancelled"
            parent="menu_all_service_root"
            action="call_center_cancelled_service_action"
            sequence="6"
        />
        <menuitem
            id="menu_requested_service"
            name="Requested Services"
            parent="menu_all_service_root"
            action="call_center_requested_service_action"
            sequence="7"
        />
        <menuitem
            id="menu_scheduled_service"
            name="Scheduled"
            parent="menu_all_service_root"
            action="call_center_initiate_service_action"
            sequence="4"
        />
    </data>
</odoo>