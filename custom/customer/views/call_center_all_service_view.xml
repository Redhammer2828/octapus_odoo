<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="call_center_all_service_view_tree" model="ir.ui.view">
            <field name="name">call.center.all.service.view.tree</field>
            <field name="model">aaa.service</field>
            <field name="arch" type="xml">
                <tree string="" create="False">
                    <field name="customer_id" />
                    <field name="credit_customer_co" />
                    <field name="sequence_id" />
                    <field name="member_id" />
                    <field name="product_id" />
                    <!-- <field name="provider_from_location_id" string="From" /> -->
                    <!-- <field name="provider_to_location_id" string="To" /> -->
                    <field name="state" string="State" />
                </tree>
            </field>
        </record>
        <record id="call_center_all_service_action" model="ir.actions.act_window">
            <field name="name">All Service</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="view_ids"
                eval="[
                  (5, 0, 0),
                  (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
                  (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
                ]">
            </field>
        </record>
        <record id="call_center_to_dispatch_service_action" model="ir.actions.act_window">
            <field name="name">To Dispatch</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=', 'dispatch')]</field>
            <field name="context">{}</field>
            <field name="view_ids"
            eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
        </field>
        </record>
        <record id="call_center_in_progress_service_action" model="ir.actions.act_window">
            <field name="name">In Progress</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', 'in', ['inprogress', 'start', 'reach'])]</field>
            <field name="context">{}</field>
            <field name="view_ids"
            eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
        </field>
        </record>
        <record id="call_center_completed_service_action" model="ir.actions.act_window">
            <field name="name">Completed</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=', 'done')]</field>
            <field name="context">{}</field>
            <field name="view_ids"
            eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
        </field>
        </record>
        <record id="call_center_cancelled_service_action" model="ir.actions.act_window">
            <field name="name">Cancelled</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '=', 'cancel')]</field>
            <field name="context">{}</field>
            <field name="view_ids"
            eval="[
              (5, 0, 0),
              (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.call_center_all_service_view_tree')}),
              (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
            ]">
        </field>
        </record>
        <menuitem
            id="menu_all_service_root"
            name="All Services"
            parent="menu_call_center_root"
            sequence="3"
        />
        <menuitem
            id="menu_all_service"
            name="All"
            parent="menu_all_service_root"
            action="call_center_all_service_action"
            sequence="1"
        />
        <menuitem
            id="menu_to_dispatch_service"
            name="To Dispatch"
            parent="menu_all_service_root"
            action="call_center_to_dispatch_service_action"
            sequence="2"
        />
        <menuitem
            id="menu_in_progress_service"
            name="In Progress"
            parent="menu_all_service_root"
            action="call_center_in_progress_service_action"
            sequence="3"
        />
        <menuitem
            id="menu_completed_service"
            name="Completed"
            parent="menu_all_service_root"
            action="call_center_completed_service_action"
            sequence="4"
        />
        <menuitem
            id="menu_cancelled_service"
            name="Cancelled"
            parent="menu_all_service_root"
            action="call_center_cancelled_service_action"
            sequence="5"
        />
    </data>
</odoo>