<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afl_dashboard_form" model="ir.ui.view">
        <field name="name">afl.dashboard.form</field>
        <field name="model">afl.dashboard</field>
        <field name="arch" type="xml">
            <form string="AFL Service Dashboard" create="0" edit="0" delete="0">
                <sheet>
                    <!-- Hide the name field -->
                    <field name="name" invisible="1" />
                    <!-- Custom Styling -->
                    <style>
                        /* Minimal palette with limited accents */
                        :root {
                            --primary: #2563eb;  /* blue */
                            --success: #16a34a;  /* green */
                            --danger:  #dc2626;  /* red */
                            --warning: #f59e0b;  /* amber */
                            --whatsapp: #25D366; /* whatsapp green */
                            --text:    #111827;  /* gray-900 */
                            --muted:   #6b7280;  /* gray-500 */
                            --border:  #e5e7eb;  /* gray-200 */
                            /* subtle background tints */
                            --primary-bg: #eff6ff;  /* blue-50 */
                            --success-bg: #ecfdf5;  /* green-50 */
                            --danger-bg:  #fef2f2;  /* red-50 */
                            --warning-bg: #fffbeb;  /* amber-50 */
                            --whatsapp-bg: #eafaef; /* whatsapp tint */
                            /* effects */
                            --card-shadow: 0 2px 6px rgba(17, 24, 39, 0.08);
                            --hover-shadow: 0 6px 18px rgba(17, 24, 39, 0.10);
                            --focus-ring: 0 0 0 3px rgba(37, 99, 235, 0.25);
                        }

                        /* Layout */
                        .main-dashboard-container { display: flex; flex-direction: column; gap: 16px; padding: 12px; max-width: 100vw; height: calc(100vh - 130px); margin: 0 auto; overflow: hidden; box-sizing: border-box; }
                        .dashboard-section { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 12px; box-shadow: none; display: flex; flex-direction: column; flex: 1 1 0; min-height: 0; }
                        .dashboard-section:hover { box-shadow: none; }

                        /* Headers - professional, understated */
                        .section-header { font-size: 22px; font-weight: 700; letter-spacing: .2px; margin-bottom: 8px; display: inline-flex; align-items: center; gap: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border); text-align: center; justify-content: center; color: var(--text); flex: 0 0 auto; }
                        .section-logo { width: 24px; height: 24px; display: inline-block; }
                        .afl-header { color: var(--text) !important; border-bottom-color: var(--border) !important; }
                        .whatsapp-header { color: var(--text) !important; border-bottom-color: var(--border) !important; }
                        .whatsapp-icon { font-size: 24px; margin-right: 10px; color: var(--primary); }

                        /* Container */
                        .dashboard-container { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; align-items: stretch; justify-items: stretch; grid-auto-rows: 1fr; grid-auto-flow: row dense; width: 100%; flex: 1 1 auto; overflow: hidden; }
                        /* WhatsApp: use the same responsive grid as AFL so tiles stay in a single row when space allows */
                        .whatsapp-section .dashboard-container {
                            width: 100%;
                            margin: 0 auto;
                            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                            gap: 12px;
                        }

                        /* Cards - neutral base, subtle and consistent accents */
                        .dashboard-box {
                            display: flex;
                            flex-direction: column;
                            justify-content: center;
                            align-items: center;
                            gap: 10px;
                            padding: 20px 18px;
                            background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important;
                            color: var(--text) !important;
                            text-align: center;
                            font-size: 15px;
                            font-weight: 600;
                            border-radius: 16px;
                            border: 1px solid var(--border) !important;
                            transition: border-color 0.2s ease-in-out;
                            cursor: pointer;
                            border-top: 3px solid var(--primary); /* default accent */
                            min-height: 0;
                            height: 100%;
                            user-select: none;
                        }
                        .dashboard-box:hover { border-color: #cbd5e1; }
                        .dashboard-box:focus-visible { outline: none; box-shadow: var(--hover-shadow), var(--focus-ring); }

                        /* Accent mapping: border accent colors stay, text is black */
                        .dashboard-box.success { border-top-color: var(--success) !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.success .label { color: #000000; }
                        .dashboard-box.success .dot { background: var(--success); }
                        
                        .dashboard-box.danger  { border-top-color: var(--danger) !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.danger .label { color: #000000; }
                        .dashboard-box.danger .dot { background: var(--danger); }
                        
                        .dashboard-box.warning { border-top-color: var(--warning) !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.warning .label { color: #000000; }
                        .dashboard-box.warning .dot { background: var(--warning); }
                        
                        /* Brown: dark yellow for Services In Progress */
                        .dashboard-box.brown { border-top-color: #ca8a04 !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.brown .label { color: #000000; }
                        .dashboard-box.brown .dot { background: #ca8a04; }
                        
                        /* Blue: primary blue for New Services */
                        .dashboard-box.blue { border-top-color: var(--primary) !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.blue .label { color: #000000; }
                        
                        /* Purple: turquoise for Today's Services (will be overridden by whatsapp class) */
                        .dashboard-box.purple { border-top-color: var(--primary) !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.purple .label { color: #000000; }
                        
                        /* Violet: light violet for Assigned SLA and Reach SLA */
                        .dashboard-box.violet { border-top-color: #8e56c5 !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.violet .label { color: #000000; }
                        .dashboard-box.violet .dot { background: #8e56c5; }
                        
                        /* WhatsApp: turquoise for Today's Services */
                        .dashboard-box.whatsapp { border-top-color: #14b8a6 !important; background: linear-gradient(180deg, #ffffff 0%, #d1d5db 100%) !important; }
                        .dashboard-box.whatsapp .label { color: #000000; }
                        .dashboard-box.whatsapp .icon { background: var(--whatsapp-bg); color: #14b8a6; }
                        .dashboard-box.whatsapp .dot { background: #14b8a6; }

                        /* Content styling */
                        .dashboard-box .icon { width: 36px; height: 36px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: var(--primary-bg); color: var(--primary); font-size: 18px; font-weight: 700; }
                        .dashboard-box.success .icon { background: var(--success-bg); color: var(--success); }
                        .dashboard-box.danger  .icon { background: var(--danger-bg);  color: var(--danger); }
                        .dashboard-box.warning .icon { background: var(--warning-bg); color: var(--warning); }
                        .dashboard-box .meta { display: inline-flex; align-items: center; gap: 6px; }
                        .dashboard-box .label { font-size: 18px; font-weight: 700; letter-spacing: .3px; color: var(--muted); text-transform: uppercase; }
                        .dashboard-box .dot { width: 8px; height: 8px; border-radius: 999px; background: var(--primary); display: inline-block; }
                        .dashboard-box .count { display: block; font-size: 32px; font-weight: 800; margin-top: 2px; line-height: 1.1; color: var(--text); }

                        /* Large screens: more columns and larger cards/counts */
                        @media (min-width: 1400px) {
                            .dashboard-container { grid-template-columns: repeat(4, 1fr); }
                            .dashboard-box { padding: 20px; }
                            .dashboard-box .count { font-size: 36px; }
                        }
                        @media (min-width: 1900px) {
                            .dashboard-container { grid-template-columns: repeat(5, 1fr); }
                            .dashboard-box { padding: 20px; }
                            .dashboard-box .count { font-size: 36px; }
                        }

                        /* Responsive */
                        /* Section sizing to ensure full viewport fit */
                        .afl-section { flex: 6 1 0; }
                        .whatsapp-section { flex: 4 1 0; }
                    </style>

                    <div class="main-dashboard-container">
                        <!-- AFL Dashboard Container -->
                        <div class="dashboard-section afl-section">
                            <div class="section-header afl-header">
                                <svg class="section-logo" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" fill="var(--primary-bg)" stroke="var(--primary)" stroke-width="2" />
                                    <text x="12" y="14" text-anchor="middle" font-size="10" font-weight="700" fill="var(--primary)">AFL</text>
                                </svg>
                                AFL Service Dashboard
                            </div>
                            <div class="dashboard-container">
                                <button name="action_afl_dashboard_initiated" type="object" class="dashboard-box blue">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">New services</span><span class="dot"></span></div>
                                    <span class="count"><field name="initiate_count"/></span>
                                </button>

                                <button name="action_afl_dashboard_inprogress" type="object" class="dashboard-box brown">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Services In Progress</span><span class="dot"></span></div>
                                    <span class="count"><field name="progress_count"/></span>
                                </button>

                                <button name="action_afl_dashboard_completed" type="object" class="dashboard-box success">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Services Completed</span><span class="dot"></span></div>
                                    <span class="count"><field name="done_count"/></span>
                                </button>

                                <button name="action_afl_dashboard_driver_cancel_reach" type="object" class="dashboard-box danger">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Reached &amp; Cancelled</span><span class="dot"></span></div>
                                    <span class="count"><field name="driver_cancel_reach_count"/></span>
                                </button>

                                <button name="action_afl_dashboard_cancelled" type="object" class="dashboard-box danger">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Services Cancelled</span><span class="dot"></span></div>
                                    <span class="count"><field name="cancelled_count"/></span>
                                </button>

                                <button name="action_afl_dashboard_total" type="object" class="dashboard-box whatsapp">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Today's Services</span><span class="dot"></span></div>
                                    <span class="count"><field name="total_count"/></span>
                                </button>

                                <!-- NUMBER OF ASSIGNED SLA -->
                                <button name="action_afl_dashboard_assigned_sla" type="object" class="dashboard-box violet">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Assigned SLA</span><span class="dot"></span></div>
                                    <span class="count"><field name="assigned_sla_count"/>%</span>
                                </button>
                                <!-- NUMBER OF reached SLA -->
                                <button name="action_afl_dashboard_reached_sla" type="object" class="dashboard-box violet">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Reach SLA</span><span class="dot"></span></div>
                                    <span class="count"><field name="reached_sla_count"/>%</span>
                                </button>
                            </div>
                        </div>

                        <!-- WhatsApp Dashboard Container -->
                        <div class="dashboard-section whatsapp-section">
                            <div class="section-header whatsapp-header">
                                <svg class="section-logo" viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="12" r="10" fill="var(--whatsapp-bg)" stroke="var(--whatsapp)" stroke-width="2" />
                                    <path d="M8 10c1.5 3 4.5 5 8 6" stroke="var(--whatsapp)" stroke-width="2" fill="none" stroke-linecap="round" />
                                </svg>
                                WhatsApp Service Dashboard
                            </div>
                            <div class="dashboard-container">
                                <button name="action_whatsapp_initiated" type="object" class="dashboard-box blue">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">New Services</span><span class="dot"></span></div>
                                    <span class="count"><field name="whatsapp_initiate_count"/></span>
                                </button>
                                <button name="action_whatsaspp_service_completed" type="object" class="dashboard-box success">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Services Completed</span><span class="dot"></span></div>
                                    <span class="count"><field name="whatsapp_done_count"/></span>
                                </button>
                                <button name="action_whatsapp_cancelled" type="object" class="dashboard-box danger">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Services Cancelled</span><span class="dot"></span></div>
                                    <span class="count"><field name="whatsapp_cancel_count"/></span>
                                </button>
                                <button name="action_dashboard_todays_whatsapp" type="object" class="dashboard-box whatsapp">
                                    <span class="icon" aria-hidden="true"></span>
                                    <div class="meta"><span class="label">Today's Services</span><span class="dot"></span></div>
                                    <span class="count"><field name="today_whatsapp_count"/></span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <group string="Service Details" invisible='1'>
                        <field name="comment_text" />
                        <tree string="AFL Services" editable="false">
                            <field name="ser_id" />
                            <field name="job_ref" />
                            <field name="state" />
                            <field name="initiate_date" />
                            <field name="driver_reach_date" />
                        </tree>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="afl_dashboard_action" model="ir.actions.act_window">
        <field name="name">AFL Service Dashboard</field>
        <field name="res_model">afl.dashboard</field>
        <field name="view_mode">form</field>
    </record>

    <menuitem id="menu_afl_service_root" name="Dashboard" parent="menu_call_center_root"
        sequence="10" />
    <menuitem id="menu_afl_service_dashboard" name="Dashboard" parent="menu_afl_service_root"
        action="afl_dashboard_action" sequence="1" />
    <menuitem id="menu_afl_service_list" name="Service List"
        parent="menu_afl_service_root"
        action="afl_service_action"
        sequence="2" />
</odoo>