<odoo>
    <data>

        <record id="view_card_type_form" model="ir.ui.view">
            <field name="name">card.type.form</field>
            <field name="model">card.type</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name" />
                        <field name="code" />
                    </group>
                </form>
            </field>
        </record>

        <record id="view_card_type_tree" model="ir.ui.view">
            <field name="name">card.type.tree</field>
            <field name="model">card.type</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="code" />
                    <field name="name" />
                    <field name="create_date"/>
                </tree>
            </field>
        </record>

        <record id="action_card_type" model="ir.actions.act_window">
            <field name="name">Card type</field>
            <field name="res_model">card.type</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new card type.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_card_type"
            name="Card type"
            parent="menu_configuration"
            action="action_card_type"
            sequence="30" />


    </data>
</odoo>