<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!-- Form View AAA LOCATION -->
        <record id="aaa_location_view_form" model="ir.ui.view">
            <field name="name">aaa.location.view.form</field>
            <field name="model">aaa.location</field>
            <field name="arch" type="xml">
                <form string="Internal Location">
                    <sheet>
                        <group>
                            <field name="name" required="1" string="Location" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- Tree aaa location -->
        <record id="aaa_location_view_tree" model="ir.ui.view">
            <field name="name">aaa.location.view.tree</field>
            <field name="model">aaa.location</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name" />
                </tree>
            </field>
        </record>

<!-- ............................................................................................ -->
        <!-- AAA LOCATION INTERNAL Action -->
        <record id="aaa_internal_location_action" model="ir.actions.act_window">
            <field name="name">AAA INTERNAL LOCATION</field>
            <field name="res_model">aaa.location</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[
        (5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.aaa_location_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('customer.aaa_location_view_form')})
    ]" />
            <!-- Add context to set 'type' to 'internal' -->
            <field name="context">{'default_type': 'internal'}</field>
            <field name="domain">[('type', '=', 'internal')]</field>
        </record>

        <!-- AAA LOCATION EXTERNAL Action -->
        <record id="aaa_external_location_action" model="ir.actions.act_window">
            <field name="name">AAA EXTERNAL LOCATION</field>
            <field name="res_model">aaa.location</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[
      (5, 0, 0),
      (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.aaa_location_view_tree')}),
      (0, 0, {'view_mode': 'form', 'view_id': ref('customer.aaa_location_view_form')})
    ]">
            </field>
            <field name="context">{'default_type': 'external'}</field>
            <field name="domain">[('type', '=', 'external')]</field>

        </record>
<!-- ............................................................................................ -->

        <menuitem
            id="menu_location_internal"
            name="Internal"
            parent="menu_location"
            action="aaa_internal_location_action"
            sequence="60" />

        <menuitem
            id="menu_location_external"
            name="External"
            parent="menu_location"
            action="aaa_external_location_action"
            sequence="70" />

    </data>


</odoo>