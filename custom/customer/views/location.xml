<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <!-- Form View INTERNAL LOCATION -->
        <record id="location_internal_view_form" model="ir.ui.view">
            <field name="name">location.internal.view.form</field>
            <field name="model">location.internal</field>
            <field name="arch" type="xml">
                <form string="Internal Location">
                    <sheet>
                        <group>
                            <field name="name" required="1" string="Location" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Form View EXTERNAL LOCATION -->
        <record id="location_external_view_form" model="ir.ui.view">
            <field name="name">location.external.view.form</field>
            <field name="model">location.external</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <field name="name" string="Location" required="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Form View SERVICE LOCATION -->
        <record id="view_location_service_form" model="ir.ui.view">
            <field name="name">location.service.form</field>
            <field name="model">location.service</field>
            <field name="arch" type="xml">
                <form string="Service Location">
                    <group>
                        <group>
                            <field name="from_location" />
                            <field name="from_latitude" />
                            <field name="from_longitude" />
                            <field name="from_h3index" />
                        </group>
                        <group>
                            <field name="to_location" />
                            <field name="to_latitude" />
                            <field name="to_longitude" />
                            <field name="to_h3index" />
                        </group>
                    </group>
                    <group>
                        <field name="amount" />
                    </group>
                </form>
            </field>
        </record>

        <!-- Tree INTERNAL -->
        <record id="location_internal_view_tree" model="ir.ui.view">
            <field name="name">location.internal.view.tree</field>
            <field name="model">location.internal</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <!-- Tree EXTERNAL -->
        <record id="location_external_view_tree" model="ir.ui.view">
            <field name="name">location.external.view.tree</field>
            <field name="model">location.external</field>
            <field name="arch" type="xml">
                <tree string="External Location">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <!-- Tree SERVICE LOCATION -->
        <record id="view_location_service_tree" model="ir.ui.view">
            <field name="name">location.service.tree</field>
            <field name="model">location.service</field>
            <field name="arch" type="xml">
                <tree string="Service Location">
                    <field name="from_location" />
                    <field name="to_location" />
                    <field name="amount" />
                    <field name="from_h3index" />
                    <field name="to_h3index" />
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="location_internal_action" model="ir.actions.act_window">
            <field name="name">Internal</field>
            <field name="res_model">location.internal</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new card type.
                </p>
            </field>
        </record>

        <record id="location_external_action" model="ir.actions.act_window">
            <field name="name">External</field>
            <field name="res_model">location.external</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new card type.
                </p>
            </field>
        </record>

        <!-- Action to open the Tree View -->
        <record id="action_location_service" model="ir.actions.act_window">
            <field name="name">Service Locations</field>
            <field name="res_model">location.service</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="view_id" ref="view_location_service_tree" /> -->
        </record>

        <menuitem
            id="menu_location_internal"
            name="Internal"
            parent="menu_location"
            action="location_internal_action"
            sequence="60" />

        <menuitem
            id="menu_location_external"
            name="External"
            parent="menu_location"
            action="location_external_action"
            sequence="70" />

        <menuitem
            id="menu_service_location"
            name="Service Location"
            parent="menu_location"
            action="action_location_service"
            sequence="80" />

    </data>


</odoo>