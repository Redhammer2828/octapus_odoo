<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="product_service_view_form" model="ir.ui.view">
            <field name="name">product.service.view.form</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <style>
                            .o_form_view:not(.o_field_highlight)
                            .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                            .o_input:not(:hover):not(:focus)
                            {
                            border-bottom: 1px solid #71639e2b;
                            }
                            .required_field{
                                background-color: #b9a4ff29;
                            }
                        </style>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active" widget_id="widget_1" />
                        <field name="id" invisible="True" field_id="id_0" />
                        <field name="image_1920" widget="image" class="oe_avatar"
                            options="{'preview_image': 'image_128'}" field_id="image_1920_0" />
                        <div class="oe_title">
                            <label for="name" string="Product Name" />
                            <h1>
                                <div class="d-flex">
                                    <field name="priority" widget="priority" class="me-3"
                                        field_id="priority_0" />
                                    <field class="text-break required_field" name="name"
                                        options="{'line_breaks': False}" widget="text"
                                        placeholder="Product Name" field_id="name_0" />
                                </div>
                            </h1>
                        </div>
                        <div name="options">
                            <span class="d-inline-block">
                                <field name="sale_ok" field_id="sale_ok_0" />
                                <label for="sale_ok" />
                            </span>
                            <span class="d-inline-block">
                                <field name="purchase_ok" field_id="purchase_ok_0" />
                                <label for="purchase_ok" />
                            </span>
                            <span class="d-inline-block">
                                <field name="bundle_product" on_change="1" />
                                <label for="bundle_product" string="Bundle product?" />
                            </span>
                            <!-- <span class="d-inline-block">
                                <field name="is_packages" on_change="1" invisible="1"/>
                                <label for="is_packages" string="is Packages" />
                            </span>
                            <span class="d-inline-block">
                                <field name="is_services" on_change="1" invisible="1"/>
                                <label for="is_services" string="is Services" />
                            </span> -->
                        </div>
                        <notebook>
                            <page string="General Information" name="general_information">
                                <group>
                                    <group name="group_general">
                                        <field name="active" invisible="1" field_id="active_0" />
                                        <field name="detailed_type" on_change="1"
                                            field_id="detailed_type_0" class="required_field" required='1' />
                                        <field name="service_based" class="required_field" required='1' />
                                        <field name="categ_id" string="Product Category"
                                            on_change="1" can_create="True" can_write="True"
                                            field_id="categ_id_0" class="required_field" required='1'/>
                                    </group>
                                    <group name="Unit of Measure">
                                        <field name="uom_id" class="required_field" required='1'/>
                                        <field name="uom_po_id" class="required_field" required='1'/>
                                    </group>
                                </group>
                                <group string="Internal Notes">
                                    <field colspan="2" name="description" nolabel="1"
                                        placeholder="This note is only for internal purposes."
                                        field_id="description_0" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_service_view_tree" model="ir.ui.view">
            <field name="name">product.service.view.tree</field>
            <field name="model">product.template</field>
            <field name="arch" type="xml">
                <tree string="Services">
                    <field name="name" />
                    <field name="create_date" />
                </tree>
            </field>
        </record>

        <record id="product_service_action" model="ir.actions.act_window">
            <field name="name">Product Service</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'product_service_view_form': True ,
                'default_bundle_product': False ,
                'default_service_based': 'none' ,
                'default_detailed_type': 'service'}</field>
                <field name="domain">[
                    ('bundle_product', '=', False)]</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.product_service_view_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.product_service_view_form')})
        ]">
            </field>
        </record>

        <menuitem
            id="menu_product_service"
            name="Services"
            parent="menu_product"
            action="product_service_action"
            sequence="20" />

    </data>


</odoo>