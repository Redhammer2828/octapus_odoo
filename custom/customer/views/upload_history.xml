<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="policy_member_upload_history_view_tree" model="ir.ui.view">
            <field name="name">policy.member.upload.history.view.tree</field>
            <field name="model">data.upload.file</field>
            <field name="arch" type="xml">
                <tree string="Upload History" create="false" edit="false" delete="True">
                    <field name="name" decoration-primary="state == 'validate'" decoration-danger="state == 'draft'" decoration-success="state == 'done'"/>
                    <field name="date"  decoration-primary="state == 'validate'" decoration-danger="state == 'draft'" decoration-success="state == 'done'"/>
                    <field name="upload_by"  decoration-primary="state == 'validate'" decoration-danger="state == 'draft'" decoration-success="state == 'done'"/>
                    <field name="upload_log"  decoration-primary="state == 'validate'" decoration-danger="state == 'draft'" decoration-success="state == 'done'"/>
                    <field name="state" decoration-primary="state == 'validate'" decoration-danger="state == 'draft'" decoration-success="state == 'done'"/>
                </tree>
            </field>
        </record>

        <record id="upload_history_action" model="ir.actions.act_window">
            <field name="name">Upload History</field>
            <field name="res_model">data.upload.file</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.policy_member_upload_history_view_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.data_upload_file_policy_form')})
          ]">
            </field>
        </record>


    </data>
</odoo>