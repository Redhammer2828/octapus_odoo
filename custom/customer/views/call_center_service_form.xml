<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="call_center_service_form" model="ir.ui.view">
            <field name="name">call.center.service.form</field>
            <field name="model">aaa.service</field>
            <field name="arch" type="xml">
                <form string="Service" delete="false" duplicate="false"
                    readonly="state in['cancel', 'done']">
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus)
                        {
                        border-bottom: 1px solid #71639e2b;
                        }
                        .addon_tree{
                        height:100%;
                        width:320px !important;
                        }
                        .product_field{
                        width: 100%;
                        }
                        .required_field{
                        background-color: #b9a4ff29;
                        }
                        .oe_chatter {
                        display: flex;
                        justify-content: center;
                        margin: 0 auto;
                        width: 100%;
                        text-align: center; /* Ensure centered text within the footer */
                        }
                    </style>
                    <header>
                        <button name="action_initiate_service" string="Initiate" type="object"
                            class="btn-primary" invisible="state != 'draft'" />
                        <button name="action_dispatch_service" string="To Dispatch" type="object"
                            class="oe_highlight" invisible="state != 'initiate'" />
                        <button name="action_schedule_service_check" string="Schedule Service"
                            type="object" class="btn-default"
                            invisible="state not in ('initiate')" />
                        <button name="action_start_service" string="Start" type="object"
                            class="btn-primary" invisible="state != 'dispatch'" />
                        <button name="action_reach_service" string="Reach" type="object"
                            class="btn-primary" invisible="state != 'start'" />
                        <button name="action_completed_rac" string="Completed RAC" type="object"
                            class="btn-primary"
                            confirm="Complete this RAC service, do you want to proceed?"
                            invisible="service_based != 'location_duration' or state != 'reach'" />
                        <button name="action_done_service" string="Done" type="object"
                            class="btn-primary"
                            invisible="service_based != 'location_duration' or state != 'completed_by_driver'" />
                        <button name="action_done_service" string="Completed" type="object"
                            class="btn-primary"
                            confirm="Complete this service, do you want to proceed?"
                            invisible="state != 'reach' or service_based == 'location_duration'" />
                        <button name="action_cancel_service" type="object" string="Cancel"
                            confirm="Cancel this service, do you want to proceed?"
                            invisible="state not in ('initiate', 'dispatch', 'start', 'reach')" />
                        <button name="action_request_service" type="object" string="Request"
                            invisible="state != 'cancel'" groups="base.group_user"
                            class="btn-primary" />
                        <button name="action_approve_service" type="object" string="Approve"
                            groups="base.group_system" invisible="state != 'requested'"
                            class="btn-primary" />
                        <button name="action_new_change" type="object" string="New Change"
                            invisible="state not in ('change')" />
                        <button name="action_change" type="object" string="Change"
                            confirm="Change this service, do you want to proceed?"
                            invisible="state not in ('initiate', 'dispatch', 'start','completed_by_driver', 'reach')" />
                        <button name="action_create_enquiry" string="Enquiry" type="object"
                            class="btn-default"
                            invisible="state not in ('initiate', 'dispatch', 'start', 'reach','completed_by_driver')" />
                        <button name="action_new" string="New Service" type="object"
                            invisible="state != 'discard'" />
                        <field name="state" widget="statusbar" nolabel="1"
                            statusbar_visible="initiate,dispatch,start,reach,completed_by_driver,done" />
                    </header>
                    <sheet>
                        <div class="row"
                            style="font-weight: bold; color: #7c7bad; border: solid 1px #8080805c; margin-left: 1%; margin-right: 1%; background-color: #eee; padding-top: .7%;margin-bottom: -.5%;border-radius: 10px;">
                            <div class="col-md-3"> Number: <field name="name" readonly="1"
                                    style="color:green;" />
                            </div>
                            <div class="col-md-2"> Service Type: <field name="type"
                                    readonly="1" style="color:green;" />
                            </div>
                            <div class="col-md-2"> Member Type: <field name="member_type"
                                    readonly="1"
                                    style="color:green;" />
                            </div>
                            <div class="col-md-2"> Card Type: <field name="card_type" readonly="1"
                                    style="color:green;" />
                            </div>
                            <div class="col-md-3"> Agent: <field name="created_by"
                                    widget="selection"
                                    readonly="1" style="color:green !important;" />
                            </div>
                        </div>
                        <group col="3">
                            <group string="GENERAL INFORMATION" name="general_information">
                                <field name="customer_id" string="Customer"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']"
                                    class="required_field" required="1"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="credit_customer_co" string="Customer C/O"
                                    readonly="state in['cancel', 'done']" />
                                <field name="sequence_id" string="Customer Category"
                                    class="required_field"
                                    required="1" options="{'no_create': True, 'no_open': True}"
                                    readonly="state in['cancel', 'done']" />
                                <field name="member_id" string="Member"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']"
                                    class="required_field" required="1"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="membership_num" readonly="state in['cancel', 'done']" />
                                <field name="member_contact_no" string="Mobile Number"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']" />
                                <field name="email" string="Email"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']" />
                                <field name="claim_membership" invisible="type != 'cash'"
                                    readonly="state not in ['initiate', 'dispatch']" />
                                <field name="deposit_amount" invisible="1" />
                                <field name="schedule_service_check" readonly="1" invisible="1" />
                                <field name="schedule_date_time"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']"
                                    invisible="schedule_service_check == False"
                                    required="schedule_service_check == True" />
                                <field name="requested_date"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']" />
                                <field name="driving_license" string="Driving License"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']" />
                                <field name="claim_number" readonly="state == 'done'" />
                                <field name="smarto" readonly="state in ['cancel', 'discard']" />
                                <field name="smarto_id" readonly="state in ['cancel', 'discard']"
                                    invisible="smarto != True" required="smarto == True" />
                                <field name="comments" string="Comments" />
                                <field name="import_comments" string="Comments"
                                    invisible="is_imported == False" readonly='1' />
                                <field name="orgin_no" string="Orgin"
                                    invisible="state not in ('change', 'initiate')" readonly="1" />
                            </group>
                            <group string="VEHICLE DETAILS" name="vehicle_details">
                                <field name="vehicle_type" string="Vehicle Type"
                                    readonly="state not in ['draft', 'initiate', 'dispatch','start','reach']" />
                                <field name="vehicle_model" string="Vehicle Model"
                                    readonly="state not in ['draft', 'initiate', 'dispatch','start','reach']" />
                                <field name="vehicle_plate" string="Vehicle Plate"
                                    readonly="state not in ['draft', 'initiate', 'dispatch']" />
                                <field name="vehicle_chasis_no" string="Vehicle Chasis No"
                                    readonly="state not in ['draft', 'initiate', 'dispatch'] or vehicle_chasis_no != False " />
                                <field name="policy_no" string="Policy No"
                                    readonly="state not in ['draft', 'initiate', 'dispatch'] or policy_no != False" />
                                <field name="member_activate_date"
                                    readonly="member_activate_date != False" />
                                <field name="member_expiry_date"
                                    readonly="member_expiry_date != False" />
                            </group>
                            <group string="SERVICE DETAILS" name="service_details">
                                <group class="product_field">
                                    <field name="product_id" string="Service" class="required_field"
                                        required="1" options="{'no_create': True, 'no_open': True}"
                                        readonly="state in['cancel', 'done']" />
                                    <field name="service_based" invisible="1" />
                                    <field name="search_query"
                                        style="background-color: #e6dddd;border-radius: 9px;"
                                        placeholder="Type Location name..."
                                        readonly="state in['cancel', 'done']"
                                        invisible="(is_imported == True) or (is_imported == False and member_type == 'credit')" />
                                    <field name="search_results" widget="many2many_tags"
                                        options="{'no_create': True}"
                                        invisible="(is_imported == True) or (member_type == 'credit')" />
                                    <field name="selected_from_location"
                                        domain="[('id', 'in', search_results)]"
                                        options="{'no_create': True, 'no_open': True}"
                                        invisible="(is_imported == True) or (service_based == 'location') or (service_based == 'location_duration') or (member_type == 'credit')"
                                        class="required_field"
                                        required="1" readonly="state in['cancel', 'done']" />
                                    <field name="is_imported" invisible="1" />
                                    <field name="from_location"
                                        invisible="not (is_imported or member_type == 'credit')"
                                        options="{'no_create': True, 'no_open': True}" />
                                    <field name="from_location_emirate"
                                        style="font-weight: 500;color: #28a745;"
                                        invisible="(is_imported == True) or (service_based == 'location') or (service_based == 'location_duration') or (member_type == 'credit')" />
                                    <field name="selected_to_location"
                                        domain="[('id', 'in', search_results)]"
                                        options="{'no_create': True, 'no_open': True}"
                                        class="required_field"
                                        required="1" readonly="state in['cancel', 'done']"
                                        invisible="(is_imported == True) or (member_type == 'credit')" />
                                    <field name="to_location"
                                        invisible="not (is_imported or member_type == 'credit')"
                                        options="{'no_create': True, 'no_open': True}" />
                                    <field name="to_location_emirate"
                                        style="font-weight: 500;color: #28a745;"
                                        invisible="(is_imported == True) or (member_type == 'credit')" />
                                    <field name="amount" />
                                    <field name="date_time_from" string="From Date time"
                                        invisible="service_based != 'location_duration'"
                                        class="required_field" required="1"
                                        readonly="state in['cancel', 'done']" />
                                    <field name="date_time_to" string="To Date time"
                                        invisible="service_based != 'location_duration'"
                                        class="required_field" required="1"
                                        readonly="state in['cancel', 'done']" />
                                    <field name="quantity" string="Quantity (Days)"
                                        invisible="service_based != 'location_duration'"
                                        class="required_field" readonly="1" />
                                </group>
                                <separator string="ADDON SERVICES" colspan="4" />
                                <field name="addon_service_ids" nolabel="1"
                                    invisible="product_id == False"
                                    readonly="state in['cancel', 'done']">
                                    <tree string="Additional Services" class="addon_tree">
                                        <field name="product_id" string="Service" />
                                        <field name="description" string="Description" />
                                        <field name="price_subtotal" string="Rate" />
                                    </tree>
                                    <form string="Additional Service">
                                        <group>
                                            <field name="product_id" />
                                            <field name="from_date" invisible="product_id == False" />
                                            <field name="to_date" invisible="product_id == False" />
                                            <field name="uom" invisible="product_id == False" />
                                            <field name="quantity" invisible="product_id == False" />
                                        </group>
                                    </form>
                                </field>
                            </group>
                        </group>
                        <group col="2">
                            <group string="PROVIDER DETAILS"
                                invisible="state in ['draft', 'initiate']">
                                <field name="provider_id" string="Provider"
                                    invisible="state in ['draft', 'initiate']"
                                    readonly="state in ['done', 'cancel']"
                                    required="1" class="required_field"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="provider_num" string="Contact No"
                                    invisible="state in ['draft', 'initiate']"
                                    readonly="state in ['done', 'cancel']" />
                                <field name="route_rate" string="Route Rate"
                                    invisible="state in ['draft', 'initiate']"
                                    readonly="state in ['done', 'cancel']" />
                                <field name="avg_rating" widget="priority" string="Average Rating"
                                    invisible="state in ['draft', 'initiate']"
                                    readonly="state in ['done', 'cancel']" />
                                <field name="vehicle" string="Vehicle"
                                    invisible="state in ['draft', 'initiate']"
                                    readonly="state in ['done', 'cancel']" />
                                <field name="is_driver_name_visible" invisible="1" />
                                <field name="driver_name"
                                    invisible="is_driver_name_visible == False"
                                    readonly="state in ['done', 'cancel']" />
                                <field name="driver_id"
                                    invisible="is_driver_name_visible == True"
                                    readonly="state in ['done', 'cancel']"
                                    required="state in ['dispatch']"
                                    options="{'no_create': True, 'no_open': True}" />
                                <field name="driver_num" string="Contact No"
                                    invisible="state in ['draft', 'initiate']"
                                    readonly="state in ['done', 'cancel']" />
                            </group>
                            <group string="SUMMARY"
                                invisible="state in ['draft', 'initiate', 'dispatch']"
                                readonly="state in ['done', 'cancel']">
                                <field name="credit_proforma_number" string="Trip Sheet Number"
                                    invisible="state in ['draft', 'initiate', 'dispatch']"
                                    required="state in ['reach']" readonly="state in ['done']" />
                                <field name="vendor_rating"
                                    widget="priority" string="Rate this service"
                                    invisible="state in ['draft', 'initiate', 'dispatch']"
                                    readonly="state in ['done']" />
                                <field name="rating_user_id"
                                    string="Rating Added By"
                                    invisible="state in ['draft', 'initiate', 'dispatch']"
                                    readonly="state in ['done']" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Comments">
                                <field name="comment_history_ids" readonly="1" nolabel="1">
                                    <tree>
                                        <field name="comment" />
                                        <field name="comment_date_and_time" />
                                        <field name="comment_user" />
                                        <field name="comment_status" />
                                    </tree>
                                    <form>
                                        <group>
                                            <field name="comment" />
                                            <field name="comment_date_and_time" />
                                            <field name="comment_user"
                                                options="{'no_create': True, 'no_open': True}" />
                                            <field name="comment_status" />
                                        </group>
                                    </form>
                                </field>
                            </page>
                            <page string="Timeline">
                                <field name="service_history_ids" readonly="1">
                                    <tree>
                                        <field name="user" />
                                        <field name="time" />
                                        <field name="status" />
                                    </tree>
                                    <form>
                                        <group>
                                            <field name="user" />
                                            <field name="time" />
                                            <field name="status" />
                                        </group>
                                    </form>
                                </field>
                                <group>
                                    <field name="new_service_id" invisible="1" />
                                    <field name="cancelled_service_id" string="Origin" />
                                </group>
                            </page>
                            <page name="enquiry" string="Enquiries">
                                <field name="enquiry_ids" nolabel="1" readonly="1">
                                    <tree>
                                        <field name="name" />
                                        <field name="date" />
                                        <field name="mobile" />
                                        <field name="email" />
                                        <field name="enquiry" />
                                        <field name="created_by" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="action_call_center_credit_service_credit_new" model="ir.actions.act_window">
            <field name="name">New Members</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_member_type': 'credit', 'default_type': 'non_cash'}</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
        ]">
            </field>
        </record>
        <record id="action_call_center_adhoc_service_new" model="ir.actions.act_window">
            <field name="name">New Members</field>
            <field name="res_model">aaa.service</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_member_type': 'adhoc', 'default_type': 'cash'}</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.call_center_service_form')})
        ]">
            </field>
        </record>

        <menuitem
            id="sub_menu_service_credit_new_member"
            name="New Member"
            parent="menu_service_credit"
            action="action_call_center_credit_service_credit_new"
            sequence="1"
        />
        <menuitem
            id="menu_service_cash_adhoc_new"
            name="Service - Cash"
            parent="menu_call_center_root"
            action="action_call_center_adhoc_service_new"
            sequence="3"
        />
    </data>
</odoo>