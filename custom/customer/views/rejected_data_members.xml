<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Upload History - Bulk Upload -->
    <data>
        <record id="rejected_data_members_view_form" model="ir.ui.view">
            <field name="name">rejected.data.members.view.form</field>
            <field name="model">data.upload.file</field>
            <field name="arch" type="xml">
                <form string="Rejected Records" create="false" edit="false" delete="false" >
                    <sheet >
                        <group >
                            <group >
                                <field name="member_name" />
                                <field name="mobile" />
                                <field name="vehicle_plate" />
                                <field name="vehicle_chasis_no" />
                                <field name="member_activate_date" />
                                <field name="member_expiry_date" />
                                <field name="invoice_ref_date" />
                                <field name="customer_code" />
                                <field name="package_id" can_create="true" can_write="true" />
                                <field name="member_type" readonly="1"/>
                                <field name="customer_ref_date" />
                                <field name="old_membership_number" />
                            </group>
                            <group >
                                <field name="policy_no" />
                                <field name="vehicle_mfg_year" />
                                <field name="vehcle_reg_country_id" can_create="true" can_write="true" />
                                <field name="vehicle_emirate_id" can_create="true" can_write="true" />
                                <field name="vehicle_reg_code" />
                                <field name="street" />
                                <field name="state_id" can_create="true" can_write="true" />
                                <field name="region_code_id" can_create="true" can_write="true" />
                                <field name="country_id" can_create="true" can_write="true" />
                                <field name="delivery_ref_date" />
                                <field name="card_type_id" can_create="true" can_write="true" />
                                <field name="comment" />
                                <field name="upload_member_status" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="rejected_data_members_view_tree" model="ir.ui.view">
            <field name="name">rejected.data.members.view.tree</field>
            <field name="model">data.upload.file</field>
            <field name="arch" type="xml">
                <tree string="Rejected Records" create="false" edit="false" delete="false" >
                    <field name="member_name" />
                    <field name="mobile" />
                    <field name="vehicle_plate" />
                    <field name="vehicle_chasis_no" />
                    <field name="member_activate_date" />
                    <field name="member_expiry_date" />
                    <field name="invoice_ref_date" />
                    <field name="customer_code" />
                    <field name="package" string="Package ID" />
                    <field name="member_type" readonly="1"/>
                    <field name="customer_ref_date" />
                    <field name="old_membership_number" />
                    <field name="policy_no" />
                    <field name="vehicle_mfg_year" />
                    <field name="vehcle_reg_country_id" can_create="true" can_write="true" />
                    <field name="vehicle_emirate_id" can_create="true" can_write="true" />
                    <field name="vehicle_reg_code" />
                    <field name="street" />
                    <field name="state_id" can_create="true" can_write="true" />
                    <field name="region_code_id" can_create="true" can_write="true" />
                    <field name="country_id" can_create="true" can_write="true" />
                    <field name="delivery_ref_date" />
                    <field name="card_type_id" can_create="true" can_write="true" />
                    <field name="comment" />
                    <field name="upload_member_status" />
                </tree>
            </field>
        </record>
        
        <record id="action_rejected_data_members" model="ir.actions.act_window">
            <field name="name">Rejected Records</field>
            <field name="res_model">data.upload.file</field>
            <field name="view_mode">tree,form</field>
            <field name="context"></field>
            <field name="domain">[('upload_member_status','=','rejection')]</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.rejected_data_members_view_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.rejected_data_members_view_form')})
        ]">
            </field>
        </record>
    
    </data>
    

</odoo>
