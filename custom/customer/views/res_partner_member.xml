<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_member_form" model="ir.ui.view">
        <field name="name">res.partner.member.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <style>
                    .o_form_view:not(.o_field_highlight)
                    .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                    .o_input:not(:hover):not(:focus)
                    {
                    border-bottom: 1px solid #71639e2b;
                    }
                    .custom_field{
                    background-color: #d2d2ff8f;
                    border-radius: 5px;
                    }
                    .required_field{
                        background-color: #b9a4ff29;
                    }
                </style>
                <!-- <headers>
                    <field name="membership_state" widget="statusbar"/>
                </headers> -->
                <sheet bgcolor="lightblue">
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
					<div class="oe_title">
                        <h4>Name:</h4>
                        <field name="name" placeholder="Type.." class="required_field"/>
                        <h4>Company:</h4>
                        <field name="parent_customer_id" placeholder="select.." class="required_field" />
					</div>
                    <group col="3">
                        <group>
                            <field name="policy_no" string="Policy No" />
                            <field name="vehicle_chasis_no"  string="Vehicle Chasis No" class="required_field"/>
                            <field name="old_membership_number" />
                            <field name="member_activate_date"/>
                            <field name="member_expiry_date" class="required_field"/>
                            <field name="card_type_id" class="required_field"/>
                            <!-- <field name="member_sequence_id" required="1" /> -->
                            <field name="driving_license" class="required_field"/>
                            <field name="member_type" widget="radio" readonly="1" />
                            <field name="membership_cancel_date" readonly="1"/>
                            <field name="create_uid" string="Created By" readonly="1"/>
                        </group>
                        <group>
                            <field name="vehicle_type" string="Vehicle Type" />
                            <field name="vehicle_model" string="Vehicle Model" />
                            <field name="vehicle_reg_code" string="Vehicle Reg. Code" />
                            <field name="vehicle_plate" string="Vehicle Plate" />
                            <field name="vehicle_mfg_year" string="Vehicle Mfg Year" />
                            <!-- <field name="vehicle_emirate_id" string="Vehicle Emirate"/> -->
                            <!-- <field name="vehcle_reg_country_id" string="Vehicle Reg. Country"/> -->
                        </group>
                        <group>
                            <!-- <field name="title" class="custom-field"/> -->
                            <!-- <field name="type" invisible="1" groups="base.group_no_one"/> -->
                            <!-- <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street custom-field"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street custom-field"/>
                                <field name="city" placeholder="City" class="o_address_city custom-field"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}" context="{'country_id': country_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip custom-field"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            </div> -->
                            <!-- <field name="function" placeholder="e.g. Sales Director" class="custom-field" /> -->
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone" />
                            <field name="user_ids" invisible="1" />
                            <field name="email" widget="email"  />
                            <field name="website" widget="url" placeholder="e.g. www.bizweaver.in" />
                            <!-- <field name="category_id" widget="many2many_tags" placeholder="Tags..." options="{'no_create_edit': True}"/> -->
                            <field name="lang" class="custom-field"/>
                            <!-- <field name="region_code_id" /> -->
                            <field name="invoice_ref_date" string="Invoice Date" invisible="0" class="required_field"/>
                            <field name="delivery_ref_date" string="Delivery Date" class="custom-field"/>
                            <field name="mail_ref" class="custom-field"/>
                            <field name="related_company_customer_code" placeholder="Related Customer Code" string="Related Customer Code" invisible="1" class="custom-field"/>
                            <field name="adhoc_member" invisible="1"/>
                            <field name="credit_member_ok" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <notebook colspan="4">
                            <page name="package" string="Package" >
                                <group>
                                    <field name="product_template_id" />
                                </group>
                                <group>
                                    <field name="service_ids" widget="many2many_tags" options="{'no_create_edit': True}" domain="[('type', '=', 'service')]" />
                                </group>
                            </page>
                            <page name="internal_notes" string="Internal Notes">
                                <field name="comment" placeholder="Internal note..."/>
                            </page>
                            <!-- <page name="membership_history" string="Membership History" attrs="{'invisible': [('credit_member_ok','=',True)]}">
                                <field name="membership_history" context="{'form_view_ref': 'aaa_membership.view_res_partner_member_history_form'}">
                                    <tree>
                                        <field name="vehicle_chasis_no"/>
                                        <field name="vehicle_type"/>
                                        <field name="vehicle_plate"/>
                                        <field name="policy_no"/>
                                        <field name="member_activate_date"/>
                                        <field name="member_expiry_date"/>
                                        <field name="card_type_id" options="{'no_create_edit':1}"/>
                                    </tree>
                                </field>
                            </page> -->
                        </notebook>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_member_tree" model="ir.ui.view">
        <field name="name">res.partner.member.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Policy Members">
                <field name="id" />
                <field name="name" />
                <field name="parent_customer_id"/>
            </tree>
        </field>
    </record>
    
    <record id="action_res_partner_member" model="ir.actions.act_window">
        <field name="name">Policy Members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'from_res_partner_member_form': True ,
            'default_member_type': 'policy' }</field>
        <field name="domain">[('is_customer','=',True),('member_type','=','policy')]</field>
        <field name="view_ids"
            eval="[
      (5, 0, 0),
      (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.res_partner_member_tree')}),
      (0, 0, {'view_mode': 'form', 'view_id': ref('customer.res_partner_member_form')})
    ]">
        </field>
    </record>

    <menuitem
        id="menu_member"
        name="Policy Members"
        parent="menu_membership_root"
        action="action_res_partner_member" />
</odoo>