<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="service_dashboard_form_view" model="ir.ui.view">
            <field name="name">service.dashboard.form.view</field>
            <field name="model">service.dashboard</field>
            <field name="arch" type="xml">
                <form string="Service Dashboard">
                    <style>
                        /* Outer group styling */
                        .custom_group_outer {
                        border: 2px solid #D1C4E9;
                        padding: 16px;
                        border-radius: 12px;
                        background: linear-gradient(145deg, #ffffff, #F3E5F5);
                        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.1);
                        transition: all 0.3s ease;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        }
                        .custom_group_outer:hover {
                        box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.2);
                        }
                        /* Inner group styling */
                        .custom_group {
                        background-color: #f9f9f9;
                        border-left: 5px solid #9575CD;
                        border-radius: 8px;
                        padding: 16px;
                        margin-bottom: 20px;
                        box-shadow: 0px 2px 5px rgba(0, 0, 0, 0.05);
                        transition: border-color 0.3s;
                        }
                        .custom_group:hover {
                        border-left-color: #7E57C2;
                        }
                        /* Label and field styling */
                        .custom_group label {
                        font-weight: bold;
                        font-size: 18px;
                        color: #333;
                        }
                        .oe_label, .oe_read_only {
                        font-size: 16px;
                        color: #666;
                        }
                        .custom_group .o_wrap_input{
                        z-index:0;
                        }
                        /* Heading styling */
                        .custom_heading {
                        font-size: 28px;
                        font-weight: bold;
                        color: #512DA8;
                        margin-bottom: 20px;
                        text-align: center;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        }
                        /* Specific headings for sections */
                        .section_heading {
                        font-size: 22px;
                        font-weight: bold;
                        padding: 10px;
                        border-radius: 8px;
                        color: #FFFFFF;
                        text-align: center;
                        margin-bottom: 20px;
                        background-color: #71639e;
                        }
                        /* Container for statistics */
                        .statistics_container {
                        display: flex;
                        align-items: center;
                        width: 100%;
                        }
                        .statistics_column {
                        flex: 1;
                        min-width: 300px;
                        padding: 20px;
                        }
                        /* Dropdown adjustments for clear visibility */
                        .o_field_widget, .o_dropdown_button {
                        position: relative;
                        z-index: 1000; /* Ensure dropdown is above all other content */
                        }
                        /* Specific styles for dropdown content */
                        .o_dropdown_menu {
                        background-color: #FFFFFF; /* Solid background for dropdown */
                        border: 1px solid #CCC; /* Slight border for definition */
                        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Soft shadow for floating effect
                        */
                        padding: 4px 0; /* Padding to avoid content touching edges */
                        margin-top: 2px; /* Slight separation from the field */
                        z-index: 1050; /* Increased z-index for dropdowns */
                        }
                    </style>
                    <sheet>
                        <div class="custom_heading">Service Dashboard</div>
                        <group string="Driver Details" class="custom_group_outer">
                            <field name="employee_id" widget="many2one_avatar_user"
                                options="{'no_open': True}" placeholder="Select an employee..." />
                        </group>
                        <div string="Service Statistics" class="custom_group_outer">
                            <div class="statistics_container">
                                <div class="statistics_column">
                                    <div class="section_heading heading_today">Today</div>
                                    <group class="custom_group">
                                        <field name="completed_today" />
                                        <field name="cancelled_today" />
                                        <field name="total_today" />
                                    </group>
                                </div>
                                <div class="statistics_column">
                                    <div class="section_heading heading_week">This Week</div>
                                    <group class="custom_group">
                                        <field name="completed_week" />
                                        <field name="cancelled_week" />
                                        <field name="total_week" />
                                    </group>
                                </div>
                                <div class="statistics_column">
                                    <div class="section_heading heading_month">This Month</div>
                                    <group class="custom_group">
                                        <field name="completed_month" />
                                        <field name="cancelled_month" />
                                        <field name="total_month" />
                                    </group>
                                </div>
                                <div class="statistics_column">
                                    <div class="section_heading heading_year">This Year</div>
                                    <group class="custom_group">
                                        <field name="completed_year" />
                                        <field name="cancelled_year" />
                                        <field name="total_year" />
                                    </group>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="service_dashboard_action" model="ir.actions.act_window">
            <field name="name">Service Dashboard</field>
            <field name="res_model">service.dashboard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="service_dashboard_form_view" />
        </record>
        <menuitem id="menu_service_dashboard"
            name="Service Dashboard"
            parent="menu_call_center_root"
            action="service_dashboard_action"
            sequence="10" />
    </data>
</odoo>