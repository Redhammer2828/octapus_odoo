<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="product_category_view_form" model="ir.ui.view">
            <field name="name">product.category.view.form</field>
            <field name="model">product.category</field>
            <field name="arch" type="xml">
                <form class="oe_form_configuration">
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus)
                        {
                        border-bottom: 1px solid #71639e2b;
                        }
                        .custom_field{
                        background-color: #d2d2ff8f;
                        border-radius: 5px;
                        }
                        .required_field{
                            background-color: #b9a4ff29;
                        }
                    </style>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" name="147" icon="fa-th-list"
                                type="action"
                                context="{'search_default_categ_id': id, 'default_categ_id': id, 'group_expand': True}">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="product_count" />
                                    </span>
                                    <span class="o_stat_text"> Products</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <label for="name" string="Category" />
                            <h1>
                                <field name="name" placeholder="e.g. Lamps" required='1' class="required_field" />
                            </h1>
                        </div>
                        <group name="first" col="2">
                            <field name="parent_id" class="oe_inline" />
                        </group>
                        <!-- <group>
                            <group name="logistics" string="Logistics">
                                <field name="removal_strategy_id" options="{'no_create': True}" can_create="False"
                        can_write="False" field_id="removal_strategy_id_0"/>
                                </group>
                        </group> -->
                        <group>
                            <group name="inventory_valuation" string="Inventory Valuation">
                                <field name="property_cost_method" class="required_field" />
                                <field name="property_valuation" class="required_field" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="product_category_view_tree" model="ir.ui.view">
            <field name="name">product.category.view.tree</field>
            <field name="model">product.category</field>
            <field name="arch" type="xml">
                <tree string="Product Categories">
                    <field name="id" string="ID" />
                    <field name="display_name" string="Product Category" />
                </tree>
            </field>
        </record>

        <record id="action_product_category" model="ir.actions.act_window">
            <field name="name">Product Category</field>
            <field name="res_model">product.category</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="context">{'from_res_partner_member_form': True}</field> -->
            <!-- <field name="domain">[('is_customer','=',True)]</field> -->
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.product_category_view_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.product_category_view_form')})
        ]">
            </field>
        </record>

        <menuitem
            id="menu_product_category"
            name="Category"
            parent="menu_product"
            action="action_product_category"
            sequence="10" />

    </data>


</odoo>