<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_member_category" model="ir.ui.view">
        <field name="name">account.move.form.inherit.member.category</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add domain to partner_id field and remove create option -->
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
                <attribute name="options">{'no_create': True, 'no_quick_create': True}</attribute>
            </field>

            <!-- Insert category_id after partner_id and remove create option -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="category_id" options="{'no_create': True, 'no_quick_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>


