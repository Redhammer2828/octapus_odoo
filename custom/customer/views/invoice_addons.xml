<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_member_category" model="ir.ui.view">
        <field name="name">account.move.form.inherit.member.category</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_invoice_sent']" position="before">
                <!-- <button name="action_report_invoice" string="GENERATE INVOICE" type="object" class="btn-primary" data-hotkey="m" groups="account.group_account_invoice" invisible="state != 'posted'"/> -->

                <button name="customer.credit_invoice_pdf_report" type="action" string="Generate Invoice" invisible="state == 'draft'" class="btn-primary" />
            </xpath>
            <xpath expr="//header/button[@name='action_invoice_sent']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='preview_invoice']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Add domain to partner_id field and remove create option -->
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
                <attribute name="options">{'no_create': True, 'no_quick_create': True}</attribute>
                <attribute name="required">1</attribute>
            </field>

            <!-- Insert category_id after partner_id and remove create option -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="member_type" widget="radio" readonly="state != 'draft'" />
                <field name="category_id" options="{'no_create': True, 'no_quick_create': True}" required="1" readonly="state != 'draft'" />
            </xpath>
            <xpath expr="//form" position="inside">
                <div>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) { border-bottom: 1px solid #71639e2b; }
                        .custom_field { background-color: #d2d2ff8f; border-radius: 5px; }
                        .required_field { background-color: #b9a4ff29; }
                    </style>
                </div>
            </xpath>

            <xpath expr="//group[@id='header_left_group']/field[@name='partner_id']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>

        </field>
    </record>


    <record id="view_account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.date_filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">

                <field name="from_date" required="1" readonly="state != 'draft'" />
                <field name="to_date" required="1" readonly="state != 'draft'" />
                <field name="invoice_line_type" widget="radio" readonly="state != 'draft'" />
                <field name="product_ids" invisible="1" />
                <field name="product_id" invisible="invoice_line_type == 'consolidated' or member_type == 'credit'" options="{'no_create': True, 'no_quick_create': True}" readonly="state != 'draft'" />
                <field name="service_ids" invisible="1" />
                <field name="service_id" invisible="invoice_line_type == 'consolidated' or member_type == 'policy'" options="{'no_create': True, 'no_quick_create': True}" readonly="state != 'draft'" />
                <field name="is_rent_a_car" invisible="1" />

            </xpath>

            <xpath expr="//notebook" position="before">
                <button name="compute_services_based_on_date" type="object" string="Consolidated Invoice Lines" class="btn-primary" invisible="invoice_line_type == 'separate' or state != 'draft'" />
                <button name="compute_separate_invoice_line" type="object" string="Add to Invoice Line" class="btn-primary" invisible="invoice_line_type == 'consolidated' or state != 'draft'" />
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_distribution']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_total']" position="attributes">
                <attribute name="optional">"hide"</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="after">
                <field name="vat_amount" />
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='product_id']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_account_move_form_inherit_credit_services" model="ir.ui.view">
        <field name="name">account.move.form.inherit.credit.services</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <xpath expr="//page[@id='invoice_tab']" position="after">
                <page id="credit_services_tab" name="credit_services_tab" string="Service Statement" invisible="invoice_line_type == 'separate' or member_type == 'policy'">
                    <field name="credit_service_line_ids" widget="one2many" mode="tree" readonly="state != 'draft'">
                        <tree editable="bottom">
                            <field name="credit_invoice_id" column_invisible="1" />
                            <field name="service_date" />
                            <field name="service_number_id" />
                            <field name="trip_sheet_number" />
                            <field name="vehicle_model" />
                            <field name="vehicle_plate" />
                            <field name="service_product_id" />
                            <field name="date_time_from" column_invisible="parent.is_rent_a_car == False" />
                            <field name="date_time_to" column_invisible="parent.is_rent_a_car == False" />
                            <field name="from_location_id" column_invisible="parent.is_rent_a_car == True" />
                            <field name="to_location_id" column_invisible="parent.is_rent_a_car == True" />
                            <field name="quantity" column_invisible="parent.is_rent_a_car == False" />
                            <field name="price" />
                            <field name="add_to_invoice" />
                        </tree>
                    </field>
                    <div class="d-flex justify-content-end mt-2">
                        <button name="compute_credit_service_line_total" type="object" string="Update Invoice Price" class="btn-primary" invisible="state != 'draft'" />
                    </div>
                </page>

                <page id="policy_memberships_tab" name="policy_memberships_tab" string="Membership Details" invisible="invoice_line_type == 'separate' or member_type == 'credit'">
                    <field name="policy_membership_line_ids" widget="section_and_note_one2many" mode="tree" readonly="state != 'draft'">
                        <tree editable="bottom">
                            <field name="policy_invoice_id" column_invisible="1" />
                            <field name="membership_no" />
                            <field name="name" />
                            <field name="plate_no" />
                            <field name="chasis_no" />
                            <field name="policy_no" />
                            <field name="start_date" />
                            <field name="expiry_date" />
                            <field name="car_make" />
                            <field name="amount" />
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="om_account_asset.view_invoice_asset_category" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>


</odoo>
