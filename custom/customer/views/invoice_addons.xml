<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_member_category" model="ir.ui.view">
        <field name="name">account.move.form.inherit.member.category</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Add domain to partner_id field and remove create option -->
            <field name="partner_id" position="attributes">
                <attribute name="domain">[('is_company', '=', True)]</attribute>
                <attribute name="options">{'no_create': True, 'no_quick_create': True}</attribute>
            </field>

            <!-- Insert category_id after partner_id and remove create option -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="member_type" widget="radio" />
                <field name="category_id" options="{'no_create': True, 'no_quick_create': True}" />
            </xpath>
            <xpath expr="//form" position="inside">
                <div>
                    <style>
                        .o_form_view:not(.o_field_highlight)
                        .o_field_widget:not(.o_field_invalid):not(.o_field_highlight)
                        .o_input:not(:hover):not(:focus) { border-bottom: 1px solid #71639e2b; }
                        .custom_field { background-color: #d2d2ff8f; border-radius: 5px; }
                        .required_field { background-color: #b9a4ff29; }
                    </style>
                </div>
            </xpath>
        </field>
    </record>


    <record id="view_account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.date_filter</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">

                <field name="from_date" />
                <field name="to_date" />
                <field name="invoice_line_type" widget="radio" />
                <field name="product_ids" invisible="1" />
                <field name="product_id" invisible="invoice_line_type == 'consolidated' or member_type == 'credit'" />
                <field name="service_ids" invisible="1" />
                <field name="service_id" invisible="invoice_line_type == 'consolidated' or member_type == 'policy'" />

            </xpath>

            <xpath expr="//notebook" position="before">
                <button name="compute_services_based_on_date" type="object" string="Consolidated Invoice Lines" class="btn-primary" invisible="invoice_line_type == 'separate'" />
                <button name="compute_separate_invoice_line" type="object" string="Add to Invoice Line" class="btn-primary" invisible="invoice_line_type == 'consolidated'" />
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='name']" position="attributes">
                <attribute name="optional">"show"</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='analytic_distribution']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='price_total']" position="attributes">
                <attribute name="optional">"hide"</attribute>
            </xpath>

        </field>
    </record>

    <record id="om_account_asset.view_invoice_asset_category" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>


</odoo>


