<odoo>
    <data>
        <!-- Inherit the form view of the product.pricelist model -->
        <record id="view_product_pricelist_form_inherited" model="ir.ui.view">
            <field name="name">product.product_pricelist.form.inherit</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view" />
            <field name="arch" type="xml">
                <!-- Insert the new field after the existing currency_id field -->
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="country_group_ids" />
                    <field name="customer_type"/>
                   <field name="is_vendor"
                       string="Vendor price list"
                       widget="boolean_toggle"
                       context="{'set_is_vendor': True}"/>
                    <field name="is_customer"
                       string="customer price list"
                       widget="boolean_toggle"
                       context="{'set_is_vendor': True}"/>
                </xpath>
            </field>
        </record>

        <record id="view_product_pricelist_tree_inherited" model="ir.ui.view">
            <field name="name">product.product_pricelist.tree.inherit</field>
            <field name="model">product.pricelist</field>
            <field name="inherit_id" ref="product.product_pricelist_view_tree"/> <!-- Reference the existing tree view -->
            <field name="arch" type="xml">
                <!-- Insert the new fields after the currency_id field -->
                <xpath expr="//field[@name='currency_id']" position="after">
                    <field name="is_vendor"
                           string="Vendor Price List"
                           widget="boolean_toggle" />
                    <field name="is_customer"
                           string="Customer Price List"
                           widget="boolean_toggle" />
                </xpath>
            </field>
        </record>

        <record id="view_product_pricelist_item_form_inherited" model="ir.ui.view">
            <field name="name">product.pricelist.item.form.inherit</field>
            <field name="model">product.pricelist.item</field>
            <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <notebook>
                    <page string="Service Charge" name="sequences" required="1">
                        <field name="service_rt_ids" widget="one2many_list" invisible="applied_on != '1_product'">
                            <tree editable="bottom" required="1">
                                <field name="from_loc_id" />
                                <field name="to_loc_id" />
                                <field name="price" />
                            </tree>
                        </field>
                    </page>
                </notebook>
                </xpath>
            </field>
        </record>
        <!-- Custom Tree View for Pricelist Items -->
        <record id="product_pricelist_item_view_tree" model="ir.ui.view">
            <field name="name">product.pricelist.item.view.tree</field>
            <field name="model">product.pricelist.item</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="pricelist_id" />
                    <field name="product_tmpl_id" />
                </tree>
            </field>
        </record>

        <!-- Custom Action for Pricelist Items with the New Views -->
        <record id="action_product_pricelist_item" model="ir.actions.act_window">
            <field name="name">Pricelist item</field>
            <field name="res_model">product.pricelist.item</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="search_view_id" ref="view_res_partner_member_search" /> -->
            <!-- <field name="context">{'from_res_partner_member_form': True ,
                'default_member_type': 'policy' }</field>
            <field name="domain">[('is_customer','=',True),('member_type','=','policy'),
                ('membership_state','=','confirm')]</field> -->
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.res_partner_member_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.res_partner_member_form')})
        ]">
            </field>
        </record>

        <!-- Menu Items for Pricelists and Pricelist Items -->
        <menuitem
            id="menu_pricelist"
            name="Pricelists"
            parent="menu_configuration"
            action="product.product_pricelist_action2"
            sequence="95" />

        <menuitem
            id="menu_pricelist_items"
            name="Pricelist Items"
            parent="menu_configuration"
            action="product.product_pricelist_item_action"
            sequence="96" />
    </data>
</odoo>
