<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="external_service_view_form" model="ir.ui.view">
            <field name="name">external.service.view.form</field>
            <field name="model">external.service</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <group>
                            <div class="oe_title">
                                <h4>
                                    External Service
                                </h4>
                            </div>
                            <field name="name" />
                            <group>
                                <field name="customer_id" />
                                <field name="category" />
                                <field name="default_member" />
                            </group>
                            <notebook>
                                <page name="Vehicle Make and Model" string="Vehicle Make and Model">
                                    <field name="vehicle_model_ids" />
                                </page>
                            </notebook>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="external_service_view_tree" model="ir.ui.view">
            <field name="name">external.service.view.tree</field>
            <field name="model">external.service</field>
            <field name="arch" type="xml">
                <tree string="">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="external_service_action" model="ir.actions.act_window">
            <field name="name">External Service</field>
            <field name="res_model">external.service</field>
            <field name="view_mode">tree,form</field>
            <!-- <field name="domain">[]</field> -->
            <!-- <field name="context">{}</field> -->
            <!-- <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new card type.
                </p>
            </field> -->
        </record>
       

    </data>


</odoo>