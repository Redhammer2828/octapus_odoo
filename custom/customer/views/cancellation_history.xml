<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="policy_member_cancellation_history_view_tree" model="ir.ui.view">
            <field name="name">policy.member.upload.history.view.tree</field>
            <field name="model">data.upload.file</field>
            <field name="arch" type="xml">
                <tree string="" >
                    <!-- <field name="name" /> -->
                    <field name="date" />
                    <field name="upload_log" />
                    <field name="upload_by" />
                    <field name="state" />
                </tree>
            </field>
        </record>

        <record id="cancellation_history_action" model="ir.actions.act_window">
            <field name="name">Membership Cancellation History</field>
            <field name="res_model">member.upload.cancel</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('state','=','done')]</field>
            <field name="view_ids"
                eval="[
          (5, 0, 0),
          (0, 0, {'view_mode': 'tree', 'view_id': ref('customer.policy_member_cancellation_history_view_tree')}),
          (0, 0, {'view_mode': 'form', 'view_id': ref('customer.policy_member_upload_cancel_form')})
          ]">
            </field>
        </record>

    </data>


</odoo>