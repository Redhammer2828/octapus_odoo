<odoo>
    <data>

        <record id="view_country_code_form" model="ir.ui.view">
            <field name="name">country.code.form</field>
            <field name="model">country.code</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="c_code" />
                        <field name="country" />
                    </group>
                </form>
            </field>
        </record>

        <record id="view_country_code_tree" model="ir.ui.view">
            <field name="name">country.code.tree</field>
            <field name="model">country.code</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="c_code" />
                    <field name="country" />
                </tree>
            </field>
        </record>

        <record id="action_country_code" model="ir.actions.act_window">
            <field name="name">Country Code</field>
            <field name="res_model">country.code</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a new country_code.
                </p>
            </field>
        </record>

        <menuitem
            id="menu_country_code"
            name="Country Code"
            parent="menu_configuration"
            action="action_country_code"
            sequence="31" />
    </data>
</odoo>