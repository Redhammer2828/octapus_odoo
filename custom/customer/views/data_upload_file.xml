<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="data_upload_file_policy_form" model="ir.ui.view">
            <field name="name">data.upload.file.policy.form</field>
            <field name="model">data.upload.file</field>
            <field name="arch" type="xml">
                <form string="Policy Members Data" create="false" edit="false" copy="false">
                    <style>
                            .field_width [data-id="member_name"]{width: 2000px !important;}
                        
                    </style>
                    <header>
                        <button name="action_validate_policy_data" string="Validate" type="object"
                            invisible="state not in ['draft']" class="btn-primary" />
                        <button name="apply_member_upload_wizard" string="Apply" type="object"
                            invisible="state not in ['validate']" class="btn-primary" />
                        <button name="action_view_rejected_records" string="Rejected Records"
                            type="object" class="btn-default"
                            invisible="state not in ['validate','done']" icon="fa-times-circle"/>
                        <button name="action_view_added_records" string="Added Records"
                            type="object" class="btn-default"
                            invisible="state not in ['validate','done']" icon="fa-check-circle" />
                        <button name="action_delete_members" string="Delete Members" type="object"
                            class="btn-default" confirm="Are you sure you want to delete members?"
                            invisible="state not in ['done']" />
                        <button name="action_discard" string="Discard" type="object"
                            class="btn-default" />
                        <button name="action_cancel" string="Cancel" type="object"
                            class="btn-default" invisible="state not in ['validate']" />
                        <field name="state" widget="statusbar"
                            statusbar_visible="draft,validate,done" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1" />
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name" readonly="1" />
                                <field name="file" groups="base.group_no_one" readonly="1" />
                            </group>
                            <group>
                                <field name="date" readonly="1" />
                                <field name="upload_by" readonly="1" />
                            </group>
                        </group>
                        <!-- <group string="Members"> -->
                        <field name="upload_member_ids" nolabel="1">
                            <tree string="Data" editable="bottom" col="1"
                                decoration-success="upload_member_status == 'new'"
                                decoration-danger="upload_member_status == 'rejection'"
                                decoration-warning="upload_member_status == 'exist_temp'"
                                decoration-primary="upload_member_status == 'renewal' or upload_member_status == 'update'">

                                <field name="member_name" class="my_field"/>
                                <field name="mobile" />
                                <field name="vehicle_plate" />
                                <field name="vehicle_chasis_no" />
                                <field name="member_activate_date" />
                                <field name="member_expiry_date" />
                                <field name="invoice_ref_date" />
                                <field name="customer_code" />
                                <field name="package" string="Package ID" />
                                <field name="member_type" readonly="1" />
                                <field name="customer_ref_date" />
                                <field name="old_membership_number" />
                                <field name="policy_no" />
                                <field name="vehicle_mfg_year" />
                                <field name="vehicle_reg_country" />
                                <field name="vehicle_emirate" />
                                <field name="vehicle_reg_code" />
                                <field name="street" />
                                <field name="state" />
                                <field name="region_code" />
                                <field name="country" />
                                <field name="delivery_ref_date" />
                                <field name="card_type" />
                                <field name="comment" />
                                <field name="sequence_code" />
                                <field name="upload_member_status" />
                            </tree>
                        </field>
                        <!-- </group> -->
                        <group string="Status">
                            <field name="upload_log" readonly="1" />
                            <field name="apply_log" readonly="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree view for upload.member.line  VIEW FOR DELETE MEMBERS-->
        <record id="upload_member_line_tree_view" model="ir.ui.view">
            <field name="name">upload.member.line.tree.view</field>
            <field name="model">upload.member.line</field>
            <field name="arch" type="xml">
                <tree string="Upload Member Lines"
                    decoration-success="upload_member_status == 'new'"
                    decoration-danger="upload_member_status == 'rejection'"
                    decoration-warning="upload_member_status == 'exist_temp'"
                    decoration-primary="upload_member_status == 'renewal' or upload_member_status == 'update'">
                    <field name="member_name" />
                    <field name="mobile" />
                    <field name="vehicle_plate" />
                    <field name="vehicle_chasis_no" />
                    <field name="member_activate_date" />
                    <field name="member_expiry_date" />
                    <field name="invoice_ref_date" />
                    <field name="customer_code" />
                    <field name="package" string="Package ID" />
                    <field name="member_type" readonly="1" />
                    <field name="customer_ref_date" />
                    <field name="old_membership_number" />
                    <field name="policy_no" />
                    <field name="vehicle_mfg_year" />
                    <field name="vehicle_reg_country" />
                    <field name="vehicle_emirate" />
                    <field name="vehicle_reg_code" />
                    <field name="street" />
                    <field name="state" />
                    <field name="region_code" />
                    <field name="country" />
                    <field name="delivery_ref_date" />
                    <field name="card_type" />
                    <field name="comment" />
                    <field name="sequence_code" />
                    <field name="upload_member_status" />
                </tree>
            </field>
        </record>

        <!-- Action -->
        <record id="action_policy_data_upload_file" model="ir.actions.act_window">
            <field name="name">Action Policy Data Upload File</field>
            <field name="res_model">data.upload.file</field>
            <field name="view_mode">form</field>
            <!-- <field name="domain">[('status','=','done')]</field> -->
            <!-- <field name="target">new</field> -->
        </record>

    </data>
</odoo>