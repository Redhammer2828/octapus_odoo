<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="policy_service_history_view_form" model="ir.ui.view">
        <field name="name">policy.service.history.view.form</field>
        <field name="model">policy.service.history</field>
        <field name="arch" type="xml">
            <form string="Service History">
                <group>
                    <group>
                        <field name="member_id" readonly="1" on_change="1" can_create="true"
                            can_write="true" />
                    </group>
                    <group>
                        <field name="member_activate_date" readonly="1" />
                        <field name="member_expiry_date" readonly="1" />
                    </group>
                </group>
                <notebook>
                    <page name="category" string="Category">
                        <field name="category_line_ids" readonly="1" nolabel="1" >
                            <tree>
                                <field name="category_id" string="category" />
                                <field name="count" />
                            </tree>
                        </field>
                    </page>
                    <page name="service" string="Services">
                        <field name="line_ids" readonly="1" nolabel="1" >
                            <tree>
                                <field name="product_id" string="Service" />
                                <field name="count" />
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Close" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="policy_service_history_action" model="ir.actions.act_window">
        <field name="name">Policy Service History</field>
        <field name="res_model">policy.service.history</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>
</odoo>