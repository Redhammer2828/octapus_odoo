<odoo>
    <!-- Bulk Upload Rejected records -->
    <record id="view_upload_member_line_tree" model="ir.ui.view">
        <field name="name">upload.member.line.tree</field>
        <field name="model">upload.member.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="member_name"/>
                <field name="customer_code"/>
                <field name="vehicle_plate"/>
                <field name="vehicle_chasis_no"/>
                <field name="member_activate_date"/>
                <field name="member_expiry_date"/>
                <field name="upload_member_status"/>
                <field name="comment"/>
            </tree>
        </field>
    </record>

    <record id="action_rejected_upload_member_line" model="ir.actions.act_window">
        <field name="name">Rejected Members</field>
        <field name="res_model">upload.member.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_upload_member_line_tree"/>
        <field name="domain">[('upload_member_status', '=', 'rejection')]</field>
    </record>
</odoo>
