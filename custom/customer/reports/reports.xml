<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="credit_validation_xlsx_report" model="ir.actions.report">
        <field name="name">Credit Service Validation Report Xlsx</field>
        <field name="model">credit.service.validation</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">customer.credit_validation_xlsx_report</field>
        <field name="report_file">customer.credit_validation_xlsx_report</field>
        <field name="binding_model_id" ref="model_credit_service_validation"/>
        <field name="binding_type">report</field>
    </record>

    <record id="credit_validation_pdf_report" model="ir.actions.report">
        <field name="name">Credit Service Details Report Pdf</field>
        <field name="model">credit.service.validation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer.report_credit_validation_pdf</field>
        <field name="report_file">customer.report_credit_validation_pdf</field>
        <field name="binding_model_id" ref="model_credit_service_validation"/>
        <field name="paperformat_id" ref="paperformat_tax_invoice_no_margin"/>
    </record>

    <record id="credit_invoice_pdf_report" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">customer.report_credit_invoice_pdf</field>
        <field name="report_file">customer.report_credit_invoice_pdf</field>
        <field name="binding_model_id" ref="model_account_move"/>
        <field name="paperformat_id" ref="paperformat_tax_invoice_no_margin"/>
        <field name="print_report_name">
        (object.move_type == 'out_refund') and ('Credit Note - %s' % (object.name or '')) or ((object.move_type == 'out_invoice' and object.debit_origin_id) and ('Debit Note - %s' % (object.name or '')) or ('Invoice - %s' % (object.name or '')))
        </field>
    </record>

    <record id="invoice_xlsx_report" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">customer.invoice_xlsx_report</field>
        <field name="report_file">customer.invoice_xlsx_report</field>
        <field name="binding_model_id" ref="model_account_move"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">
        (object.move_type == 'out_refund') and ('Credit Note - %s' % (object.name or '')) or ((object.move_type == 'out_invoice' and object.debit_origin_id) and ('Debit Note - %s' % (object.name or '')) or ('Invoice - %s' % (object.name or '')))
        </field>
    </record>

</odoo>
