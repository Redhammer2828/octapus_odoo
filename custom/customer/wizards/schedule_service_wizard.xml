<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="schedule_service_wizard_view_form" model="ir.ui.view">
        <field name="name">schedule.service.wizard.view.form</field>
        <field name="model">schedule.service.wizard</field>
        <field name="arch" type="xml">
            <form string="Schedule Service">
                <sheet>
                    <group col="2">
                        <group>
                            <field name="schedule_date" string="Schedule Date" required="True" />
                            <field name="service_id" string="Action Date" invisible="1"/>
                        </group>
                        <group>
                            <field name="action_date" required="True"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_schedule" string="Proceed" class="btn-primary" type="object"/>
                        <button type="object" special="cancel" string="Cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
