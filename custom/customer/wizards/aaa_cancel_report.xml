<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="aaa_cancel_report_view_form" model="ir.ui.view">
        <field name="name">aaa.cancel.report.view.form</field>
        <field name="model">aaa.cancel.report</field>
        <field name="arch" type="xml">
            <form string="AAA Cancel Reports">
                
                <group col="2">
                    <group>
                        
                        <field name="from_date" />
                        <field name="to_date" />
                        
                    </group>
                    <group>
                        
                        <field name="customer_id" 
                         options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>
                        <field name="member_type" />
                        <field name="sequence_id" 
                         options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>
                        <field name="type" />
                        <field name="product_id"/>
                        <field name="provider_id" 
                         options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>
                        
                    </group>
                        
                </group>

                <footer>
                    
                    <button name="action_export_excel" string="Export" type="object"
                        class="btn-success" />
                    <button string="Cancel" class="btn-danger" special="cancel" />
                </footer>
                
            </form>
        </field>
    </record>

    <record id="action_aaa_cancel_report" model="ir.actions.act_window">
        <field name="name">AAA Cancel Reports</field>
        <field name="res_model">aaa.cancel.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    
    <menuitem 
        id="menu_aaa_cancel_report"
        name="AAA Cancel Reports"
        parent="menu_call_center_report"
        action="action_aaa_cancel_report"
        sequence="38" />

</odoo>
