<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="membership_extension_wizard_form" model="ir.ui.view">
        <field name="name">membership.extension.wizard.form</field>
        <field name="model">membership.extension.wizard</field>
        <field name="arch" type="xml">
            <form string="Membership Extension">
                <group>
                    <group>
                        <field name="expiry_date" readonly="1" required="1"/>
                    </group>
                    <group>
                        <field name="new_expiry_date" on_change="1" required="1" />
                    </group>
                </group>
                <footer>
                    <button name="action_extension" string="Extend" type="object"
                        class="btn-primary" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>

        </field>
    </record>

    <record id="membership_extension_action" model="ir.actions.act_window">
        <field name="name">Membership Extension Action</field>
        <field name="res_model">membership.extension.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>