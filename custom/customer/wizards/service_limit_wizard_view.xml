<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Service Limit Wizard Form View -->
        <record id="view_service_limit_wizard_form" model="ir.ui.view">
            <field name="name">service.limit.wizard.form</field>
            <field name="model">service.limit.wizard</field>
            <field name="arch" type="xml">
                <form string="Service Limit Reached">
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong> Service limit has been reached for this package.
                    </div>
                    <group>
                        <field name="service_id" readonly="1"/>
                        <field name="message" readonly="1"/>
                        <field name="existing_service_count" readonly="1"/>
                        <field name="service_limit" readonly="1"/>
                        <field name="service_type" readonly="1"/>
                        <field name="limit_period" readonly="1"/>
                        <field name="period_description" readonly="1"/>
                    </group>
                    <footer>
                        <button name="action_proceed" string="Proceed" type="object" class="btn-primary"/>
                        <button name="action_restrict" string="Not Proceed" type="object" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Service Limit Wizard Action -->
        <record id="action_service_limit_wizard" model="ir.actions.act_window">
            <field name="name">Service Limit Warning</field>
            <field name="res_model">service.limit.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_service_limit_wizard_form"/>
        </record>
    </data>
</odoo>