<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_enquiry_complaint_wizard_form" model="ir.ui.view">
        <field name="name">enquiry.complaint.wizard.form</field>
        <field name="model">enquiry.complaint.wizard</field>
        <field name="arch" type="xml">
            <form string="Enquiry or Complaint">
                <group>
                    <label for="is_enquiry" string="Is this an enquiry or complaint?"/>
                    <field name="is_enquiry" invisible="1"/>
                </group>
                <footer>
                    <button string="Set Enquiry" type="object" name="action_enquiry" class="btn-primary" />
                    <button string="Set Complaint" type="object" name="action_complaint" class="btn-danger" />
                </footer>
            </form>
        </field>
    </record>
    

</odoo>
