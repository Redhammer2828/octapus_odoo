<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="policy_member_cancel_upload_form" model="ir.ui.view">
            <field name="name">policy.member.cancel.upload.form</field>
            <field name="model">member.cancel.upload.wizard</field>
            <field name="arch" type="xml">
                <form string="Policy Members Cancel Upload">
                    <group>
                        <field name="file_type" string="File Type" required="1" widget="radio" />
                    </group>
                    <group>
                        <group>
                            <field name="name" string="Name" required="1" />
                            <field name="file" string="File" />
                        </group>
                        <group>
                            <field name="type" invisible="1" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_policy_member_upload_excel" class="btn-primary"
                            string="Upload Excel" type="object"
                            domain="[('file_type', '=', 'excel')]">
                        </button>
                        <button name="action_policy_member_upload_csv" class="btn-primary"
                            string="Upload CSV" type="object" domain="[('file_type', '!=', 'csv')]">
                        </button>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_view_policy_member_cancel_upload" model="ir.actions.act_window">
            <field name="name">Upload Policy Members</field>
            <field name="res_model">member.cancel.upload.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="menu_membership_cancellation"
            name="Membership Cancellation"
            parent="menu_member"
            sequence="70"
        />
        <menuitem
            id="menu_cancel_upload_file"
            name="Upload File"
            parent="menu_membership_cancellation"
            action="action_view_policy_member_cancel_upload"
            sequence="71" />

        <menuitem
            id="menu_cancel_history"
            name="Cancellation History"
            parent="menu_membership_cancellation"
            action="cancellation_history_action"
            sequence="72" />
    </data>

</odoo>