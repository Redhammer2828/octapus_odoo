<?xml version="1.0" encoding="utf-8"?>
<odoo>

   <record id="view_service_cash_wizard_form" model="ir.ui.view">
    <field name="name">service.cash.wizard</field>
    <field name="model">service.cash.wizard</field>
    <field name="arch" type="xml">
        <form string="Convert to Cash">
            <sheet>
                <group>
                    <field name="service_id" invisible="1" />
                    <label for="service_id" string="Service already provided within allowed time gap. Proceed with Cash Service?"/>
                    
                </group>
                <footer>
                    <button string="Proceed" class="btn-success" type="object" name="action_cash_service"/>
                    <button type="object" special="cancel" string="Cancel"/>
                </footer>
            </sheet>
        </form>
    </field>
   </record>

</odoo>
