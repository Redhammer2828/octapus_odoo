<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="credit_member_upload_wizard_form" model="ir.ui.view">
            <field name="name">credit.member.upload.wizard.form</field>
            <field name="model">credit.member.upload.wizard</field>
            <field name="arch" type="xml">
                <form string="Credit Member Upload Wizard" >
                    <group>
                        <field name="file_type" string="File Type" required="1" widget="radio" />
                    </group>
                    <group>
                        <group>
                            <field name="name" string="Name" required="1" />
                            <field name="file" filename="file_name" />
                            <field name="file_name" invisible="1"/>
                        </group>
                        <group>
                            <field name="type" invisible="1" />
                        </group>
                    </group>
                    <footer>
                        <button name="action_credit_member_upload_excel" class="btn-primary"
                                string="Upload Excel" type="object"
                                invisible="file_type != 'excel'"/>
                        <button name="action_credit_member_upload_csv" class="btn-primary"
                                string="Upload CSV" type="object"
                                invisible="file_type != 'csv'"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_credit_member_upload_wizard" model="ir.actions.act_window">
            <field name="name">Upload Credit Member</field>
            <field name="res_model">credit.member.upload.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem
            id="sub_menu_credit_member_upload"
            name="Upload File"
            parent="menu_credit_member"
            sequence="2"
            action="action_credit_member_upload_wizard"/>
        <menuitem 
            id="sub_menu_credit_member_upload_history" 
            name="Uploaded Members" 
            parent="menu_credit_member"
            action="action_credit_member_upload_history" 
            sequence="3"/>
    </data>

</odoo>