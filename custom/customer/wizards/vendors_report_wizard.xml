<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vendors_report_wizard_form" model="ir.ui.view">
        <field name="name">vendors.report.wizard.form</field>
        <field name="model">vendors.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Vendor Reports">
                <group col="2">
                    <group string="Invoice Date">
                        <field name="from_date" required="1"/>
                        <field name="to_date" required="1" />
                        <!-- <field name="product_template_id" /> -->
                    </group>
                    <group>
                        <field name="provider_id" required="1" options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>
                        <field name="member_type" />
                        <field name="sequence_id" options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>
                        <field name="type" />
                    </group>
                </group>
                <footer>
                    
                    <button name="action_export_excel" string="Export" type="object"
                        class="btn-success" />
                    <button string="Cancel" class="btn-danger" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for opening the wizard -->
    <record id="action_vendors_report_wizard" model="ir.actions.act_window">
        <field name="name">Vendor Reports</field>
        <field name="res_model">vendors.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    

    <menuitem 
        id="vendors_report_menu"
        name="Vendor Reports"
        action="action_vendors_report_wizard"
        parent="vendor_root_menu"
        sequence="12" />

</odoo>