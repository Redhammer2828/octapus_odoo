<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_service_report_wizard_form" model="ir.ui.view">
        <field name="name">service.report.wizard.form</field>
        <field name="model">service.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Service Report">
                <group col="2">
                    <group string="Service Date">
                        <field name="from_date" />
                        <field name="to_date" />
                    </group>
                    <group>
                        <field name="customer_id" />
                        <field name="member_type" />
                        <field name="sequence_id" />
                        <field name="type" />
                    </group>
                </group>
                <footer>
                    <!-- <button name="action_print_pdf" string="Print" type="object" class="btn-primary" /> -->
                    <button name="action_export_excel" string="Export" type="object"
                        class="btn-success" />
                    <button string="Cancel" class="btn-danger" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for opening the wizard -->
    <record id="action_service_report_wizard" model="ir.actions.act_window">
        <field name="name">Credit Service Report</field>
        <field name="res_model">service.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem 
        id="menu_services_root"
        name="Credit Report"
        sequence="15" />

    <menuitem
        id="menu_dashboards"
        name="Dashboards"
        parent="menu_services_root"
        sequence="10" />
    
    <menuitem
        id="menu_service_report"
        name="Reports"
        parent="menu_services_root"
        sequence="11" />

    <menuitem 
        id="menu_service_report_wizard"
        name="Credit Service Report"
        parent="menu_service_report"
        action="action_service_report_wizard"
        sequence="17" />

</odoo>