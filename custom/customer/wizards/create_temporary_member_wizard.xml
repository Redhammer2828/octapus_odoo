<?xml version="1.0" encoding="utf-8"?>
<odoo>

    
    <record id="view_create_temporary_member_wizard" model="ir.ui.view">
        <field name="name">create.temporary.member.wizard.form</field>
        <field name="model">create.temporary.member.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Temporary Member">
                <group>
                    <field name="problem_statement" readonly="1" />
                </group>
                <footer>
                    <button name="action_proceed" string="Proceed" type="object" class="btn-primary" />
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>



</odoo>
