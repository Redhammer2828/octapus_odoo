<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="aaa_report_wizard_view_form" model="ir.ui.view">
        <field name="name">aaa.report.wizard.view.form</field>
        <field name="model">aaa.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Call center Report">
                
                    <group col="2">
                        <group>
                        
                        <field name="from_date" />
                        <field name="to_date" />
                            
                        </group>
                        <group>

                        <field name="customer_id" 
                         options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>
                        <field name="member_type" />
                        <field name="sequence_id" 
                         options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>
                        <field name="type" />
                        <field name="provider_id" 
                         options="{'no_create':True,'no_quick_create':True, 'no_create_edit':True, 'no_open':True}"/>

                        </group>
                        
                    </group>
                
                <footer>
                    <!-- <button name="action_print_pdf" string="Print" type="object" class="btn-primary" /> -->
                    <button name="action_export_excel" string="Export" type="object"
                        class="btn-success" />
                    <button string="Cancel" class="btn-danger" special="cancel" />
                </footer>
                

            </form>
        </field>
    </record>
    
    <record id="action_aaa_report_wizard" model="ir.actions.act_window">
        <field name="name">Call center Report</field>
        <field name="res_model">aaa.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    
    <menuitem id="menu_call_center_report" name="Reports"
            parent="menu_call_center_root" sequence="30" />
    <menuitem 
        id="menu_aaa_report_wizard"
        name="Call center Report"
        parent="menu_call_center_report"
        action="action_aaa_report_wizard"
        sequence="32" />

</odoo>
