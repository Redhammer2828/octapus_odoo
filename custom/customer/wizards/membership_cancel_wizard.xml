<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="membership_cancel_wizard_form" model="ir.ui.view">
        <field name="name">membership.cancel.wizard.form</field>
        <field name="model">membership.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Membership Cancel" >
                <group >
                    <group >
                        <field name="cancel_date"/>
                    </group>
                    <group >
                        <field name="comment" />
                    </group>
                </group>
                <group >
                    <field name="issue_credit_note"/>
                </group>
                <footer >
                    <button name="action_cancel" string="Membership Cancel" type="object" class="btn-primary"/>
                    <button string="Close" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
