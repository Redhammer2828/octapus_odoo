<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_policy_report_wizard_form" model="ir.ui.view">
        <field name="name">policy.report.wizard.form</field>
        <field name="model">policy.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Policy Reports">
                <group col="2">
                    <group string="Invoice Date">
                        <field name="from_date" />
                        <field name="to_date" />
                        <!-- <field name="product_template_id" /> -->
                    </group>
                    <group>
                        <field name="customer_id" />
                        <field name="member_type" />
                        <field name="sequence_id" />
                        <field name="type" />
                    </group>
                </group>
                <footer>
                    <button name="action_print_pdf" string="Print" type="object" class="btn-primary" />
                    <button name="action_export_excel" string="Export" type="object"
                        class="btn-success" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for opening the wizard -->
    <record id="action_policy_report_wizard" model="ir.actions.act_window">
        <field name="name">Policy Reports</field>
        <field name="res_model">policy.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    

    <menuitem 
        id="menu_policy_report_wizard_root"
        name="Policy Reports"
     
        action="action_policy_report_wizard"
        sequence="19" />

</odoo>