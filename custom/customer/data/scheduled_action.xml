<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ir_cron_check_and_update_service_state" model="ir.cron">
            <field name="name">Check and Update Service State</field>
            <field name="model_id" search="[('model', '=', 'aaa.service')]" />
            <field name="state">code</field>
            <field name="code">model.check_and_update_state()</field>
            <!-- The recommended minimum officially is 1 minute -->
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True" />
        </record>
    </data>
</odoo>
