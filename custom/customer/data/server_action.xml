<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_update_partner_services" model="ir.actions.server">
        <field name="name">Update All Services</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">

partners = env['res.partner'].search([('product_template_id', '!=', False)])
for partner in partners:
    partner._onchange_product_template_id()

        </field>
    </record>
</odoo>
