<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_service" model="ir.sequence">
            <field name="name">Service Sequence</field>
            <field name="code">aaa.service</field>
            <field name="prefix">SER/</field> <!-- Changed to SE/ -->
            <field name="padding">8</field>  <!-- Changed to 8 for the number part -->
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>

         <!-- Sequence for aaa.enquiry -->
        <record id="seq_enquiry" model="ir.sequence">
            <field name="name">Enquiry Sequence</field>
            <field name="code">aaa.enquiry.sequence</field>
            <field name="prefix">ENQ/%(month)s/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
        </record>
    </data>
</odoo>