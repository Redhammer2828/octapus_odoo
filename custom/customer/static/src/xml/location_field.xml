<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="customer.LocationSearchInput" owl="1">
        <div class="o_location_search_widget position-relative" t-on-click-outside="onWindowClick">
            <!-- Input -->
            <textarea
                type="text"
                class="auto-resize o_input"
                t-att-placeholder="props.placeholder || ''"
                t-att-name="props.name"
                t-att-id="props.id"
                t-ref="input"
                t-model="state.inputValue"
                t-on-input="onInput"
                autocomplete="off"
                t-att-disabled="props.readonly"
                t-att-required="props.required"
                t-att-style="state.inputValue.length > 0 and !props.readonly ? 'padding-right: 60px;' : ''"
                t-att-title="getDebugTitle()"
            />


            <!-- Clear Button -->
            <button t-if="state.inputValue.length > 0 and !state.isLoading and !props.readonly"
                    type="button"
                    class="btn position-absolute end-0 top-0 bottom-0 d-flex align-items-center justify-content-center border-0 bg-transparent text-muted o_location_clear_btn"
                    style="right: 30px; width: 24px; z-index: 3;"
                    t-on-click="clearInput"
                    title="Clear">
                <i class="fa fa-times" style="font-size: 14px;"/>
            </button>

            <!-- Spinner -->
            <div t-if="state.isLoading"
                 class="position-absolute top-0 bottom-0 d-flex align-items-center px-2"
                 style="right: 5px; z-index: 2;">
                <i class="fa fa-spinner fa-spin text-muted" />
            </div>

            <!-- Dropdown Suggestions -->
            <div t-if="state.showDropdown and state.suggestions.length > 0"
                 class="position-absolute mt-1 border rounded shadow-sm bg-white z-3 location-suggestions">
                <div class="list-group list-group-flush">
                    <button type="button"
                            t-foreach="state.suggestions"
                            t-as="suggestion"
                            t-key="suggestion.id || suggestion_index"
                            class="list-group-item list-group-item-action py-2 px-3 text-start position-relative o_location_suggestion_item"
                            t-on-click="() => this.selectLocation(suggestion, suggestion_index)"
                            t-att-title="suggestion.name">
                        <div class="fw-normal">
                            <t t-esc="suggestion.name"/>
                        </div>
                    </button>
                </div>
            </div>

            <!-- No Results -->
            <div t-if="state.showDropdown and !state.isLoading and state.inputValue.length >= 3 and state.suggestions.length === 0"
                 class="position-absolute start-0 end-0 mt-1 border rounded shadow-sm bg-white z-3 p-2 text-center text-muted">
                No locations found
            </div>
        </div>
    </t>
</templates>






